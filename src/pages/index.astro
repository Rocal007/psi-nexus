---
import Layout from '../layouts/Layout.astro';
import BirthForm from '../components/ui/BirthForm.astro';
import FolderTabs from '../components/ui/FolderTabs.astro';
import SoulJourneyProgress from '../components/ui/SoulJourneyProgress.astro';
import SoulWizardNavigator from '../components/ui/SoulWizardNavigator.astro';
import SoulQuestionCompass from '../components/ui/SoulQuestionCompass.astro';
import WizardEssenceCard from '../components/ui/WizardEssenceCard.astro';
import BirkenbihlDecoder from '../components/ui/BirkenbihlDecoder.astro';
import RadixWheel from '../components/chart/RadixWheel.astro';
import AspectMatrix from '../components/chart/AspectMatrix.astro';
import ElementBalance from '../components/chart/ElementBalance.astro';
import PlanetCard from '../components/chart/PlanetCard.astro';
import EsotericDossier from '../components/interpretation/EsotericDossier.astro';
import LifePillarsSection from '../components/interpretation/LifePillarsSection.astro';
import NumerologySection from '../components/interpretation/NumerologySection.astro';
import KarmicNodesSection from '../components/interpretation/KarmicNodesSection.astro';
import AngelNumbersSection from '../components/interpretation/AngelNumbersSection.astro';
import GemstoneSection from '../components/interpretation/GemstoneSection.astro';
import MoonAndWisdomSection from '../components/interpretation/MoonAndWisdomSection.astro';
import ConstellationExplorer from '../components/chart/ConstellationExplorer.astro';
import GeoAstroChart from '../components/chart/GeoAstroChart.astro';
import SynastryFamilySection from '../components/interpretation/SynastryFamilySection.astro';
import PersonalitySummarySection from '../components/interpretation/PersonalitySummarySection.astro';
import ShadowHealthDialecticSection from '../components/interpretation/ShadowHealthDialecticSection.astro';
import HumanDesignSection from '../components/interpretation/HumanDesignSection.astro';
import EeatTrustSection from '../components/ui/EeatTrustSection.astro';
import GseoFaqSection from '../components/ui/GseoFaqSection.astro';
import { DashboardController } from '../lib/controllers/dashboardController';

// Resolve full view model through DTO boundary & controller
const viewModel = DashboardController.handleRequest(Astro.url.searchParams);
const { hasExplicitQuery, chartInput, chart, personalitySummary, hdChart } = viewModel;
const { birthDate, birthTime, cityName, latitude, longitude, timezone, houseSystem } = chartInput;
const userName = chartInput.name || '';

const formattedBirthDate = new Date(birthDate + 'T00:00:00').toLocaleDateString('de-DE', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
---

<Layout title={`Ψ-NEXUS Seelen-Matrix | ${userName ? userName + ' • ' : ''}${chart.synthesis.sun.planet.sign.name}`}>
  <div class="boxed-canvas py-6 sm:py-8 space-y-8">
    
    <!-- Hero / Title Section in Boxed Frame -->
    <div class="boxed-frame text-center space-y-4 max-w-5xl mx-auto relative">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full birkenbihl-badge text-amber-300 text-xs font-bold uppercase tracking-widest shadow-md">
        <span class="font-serif">Ψ</span> Die Göttliche Geometrie Deines Seelenplans (Ψ-NEXUS) <span class="font-serif">Ψ</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight" id="heroName">
        {hasExplicitQuery && userName ? (
          <span><span class="cosmic-gold-gradient">{userName}s</span> Kosmisches Seelenbuch</span>
        ) : (
          <span>Entschlüssle dein <span class="cosmic-gold-gradient">Kosmisches Seelenbuch</span></span>
        )}
      </h1>

      <!-- Welcome Onboarding Prompt (Visible when no profile is active) -->
      <div id="heroWelcomePrompt" class={`space-y-2.5 max-w-2xl mx-auto pt-1 ${hasExplicitQuery ? 'hidden' : ''}`}>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold font-tech">
          <span>✨</span>
          <span>Erstelle dein Seelen-Profil</span>
        </div>
        <p class="text-slate-300 text-xs sm:text-sm md:text-base leading-relaxed font-lato">
          Trage unten deine Geburtsdaten ein oder wähle ein bestehendes Profil, um dein persönliches Kosmisches Seelenbuch, dein Radix-Horoskop und deine Lebenszahlen in Echtzeit zu generieren.
        </p>
      </div>

      <!-- Individuelle Zusammenfassung der Person im Header (Visible when profile is active) -->
      <div id="heroActiveProfileDetails" class={`space-y-2.5 max-w-3xl mx-auto ${hasExplicitQuery ? '' : 'hidden'}`}>
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold font-tech">
          <span>🌟</span>
          <span id="heroArchetypeTitle">{personalitySummary.archetypeName}</span>
        </div>
        <p class="text-slate-200 text-sm md:text-base leading-relaxed font-lato" id="heroPersonalitySummary">
          {personalitySummary.shortEssence}
        </p>
        <blockquote class="font-cormorant italic text-base md:text-lg text-amber-200/90 font-medium tracking-wide" id="heroPersonalityMantra">
          {personalitySummary.personalityMantra}
        </blockquote>
      </div>

      <!-- Key Identity Highlights Pill Bar (Unified Boxed Style) -->
      <div id="heroIdentityPillsBar" class={`flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 pt-2 ${hasExplicitQuery ? '' : 'hidden'}`}>
        <button type="button" id="pillSun" data-pill-gate="radix" class="hero-identity-pill flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-900/90 border border-white/10 hover:border-amber-400/50 hover:bg-slate-800 text-slate-200 text-xs font-bold transition-all cursor-pointer group" title="Klicke hier: Direkt zum Sonnen-Stand in Tor I springen">
          <span class="text-amber-400 text-sm">☉ Sonne:</span>
          <span class="text-white font-bold">{chart.synthesis.sun.planet.sign.name}</span>
          <span class="text-amber-300/80 font-mono text-[11px]">({chart.synthesis.sun.planet.degreeString})</span>
          <span class="text-amber-400">{chart.synthesis.sun.planet.sign.symbol}</span>
        </button>

        <button type="button" id="pillMoon" data-pill-gate="moon_wisdom" class="hero-identity-pill flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-900/90 border border-white/10 hover:border-amber-400/50 hover:bg-slate-800 text-slate-200 text-xs font-bold transition-all cursor-pointer group" title="Klicke hier: Direkt zum Mond- & Lebensführer (Tor VIII) springen">
          <span class="text-slate-300 text-sm">☽ Mond:</span>
          <span class="text-white font-bold">{chart.synthesis.moon.planet.sign.name}</span>
          <span class="text-slate-400 font-mono text-[11px]">({chart.synthesis.moon.planet.degreeString})</span>
          <span class="text-slate-300">{chart.synthesis.moon.planet.sign.symbol}</span>
        </button>

        <button type="button" id="pillAsc" data-pill-gate="radix" data-pill-subtarget="cardAC" class="hero-identity-pill flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-900/90 border border-white/10 hover:border-amber-400/50 hover:bg-slate-800 text-slate-200 text-xs font-bold transition-all cursor-pointer group" title="Klicke hier: Direkt zum Aszendenten (1. Haus) springen">
          <span class="text-amber-300/90 text-sm">↑ AC:</span>
          <span class="text-white font-bold">{chart.housesResult.angles.ascendant.sign.name}</span>
          <span class="text-amber-300/80 font-mono text-[11px]">({chart.housesResult.angles.ascendant.degreeString})</span>
          <span class="text-amber-300/90">{chart.housesResult.angles.ascendant.sign.symbol}</span>
        </button>

        <button type="button" id="pillMc" data-pill-gate="radix" data-pill-subtarget="cardMC" class="hero-identity-pill flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-900/90 border border-white/10 hover:border-amber-400/50 hover:bg-slate-800 text-slate-200 text-xs font-bold transition-all cursor-pointer group" title="Klicke hier: Direkt zum Medium Coeli (Beruf & 10. Haus) springen">
          <span class="text-amber-300/90 text-sm">❖ MC:</span>
          <span class="text-white font-bold">{chart.housesResult.angles.midheaven.sign.name}</span>
          <span class="text-amber-300/80 font-mono text-[11px]">({chart.housesResult.angles.midheaven.degreeString})</span>
          <span class="text-amber-300/90">{chart.housesResult.angles.midheaven.sign.symbol}</span>
        </button>

        <button type="button" id="pillLifePath" data-pill-gate="numerology" class="hero-identity-pill flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-900/90 border border-white/10 hover:border-amber-400/50 hover:bg-slate-800 text-slate-200 text-xs font-bold transition-all cursor-pointer group" title="Klicke hier: Direkt zu den Pythagoräischen Lebenszahlen (Tor IV) springen">
          <span class="text-amber-400 text-sm">🔢 Lebenszahl:</span>
          <span class="text-white font-bold">{chart.numerology.lifePath.number}</span>
          <span class="text-amber-300/80 text-[11px]">({chart.numerology.lifePath.archetype})</span>
        </button>
      </div>

      <div id="heroDetails" class={`text-xs text-slate-400 flex flex-wrap items-center justify-center gap-2 sm:gap-3 pt-2 ${hasExplicitQuery ? '' : 'hidden'}`}>
        <span>📍 {cityName}</span>
        <span>•</span>
        <span>🗓️ {formattedBirthDate}, {birthTime} Uhr</span>
        <span>•</span>
        <span>🌐 UTC: {chart.utcDate.toUTCString().slice(17, 22)} Uhr</span>
        <span>•</span>
        <span class="text-amber-400/90 font-medium">Häuser: {houseSystem === 'placidus' ? 'Placidus' : 'Equal'}</span>
      </div>
    </div>

    <!-- Stage 1: Input Form Section (Eingeben oder Auswählen) -->
    <div id="form-section" class="relative z-40 overflow-visible">
      <BirthForm initialValues={chartInput} hasActiveProfile={hasExplicitQuery} />
    </div>

    <!-- Stage 2: Soul Question Compass ("Und dann fragen") -->
    <div id="question-section" class={hasExplicitQuery ? '' : 'hidden'}>
      <SoulQuestionCompass userName={userName || 'Edle Seele'} sunSign={chart.synthesis.sun.planet.sign.name} />
    </div>

    <!-- Stage 3: Complete Soul Dossier (Revealed when a profile is active) -->
    <div id="soulDossierContainer" class={hasExplicitQuery ? 'space-y-8 min-w-0 w-full' : 'hidden space-y-8 min-w-0 w-full'}>
      <div id="soulDossierWrapper" class="space-y-6">
        <SoulJourneyProgress activeStep="radix" />
        <SoulWizardNavigator activeGate="radix" />
        <FolderTabs activeTab="radix" />
      </div>

      <!-- Full-Width Main Dossier Content Panels -->
      <div class="space-y-8 min-w-0 w-full">
        <!-- TAB 1: Radix & Gestirne Panel (Tor I) -->
        <div id="panel-radix" class="tab-content-panel active space-y-8">
            
            <!-- Wizard Sofort-Erkenntnis Chunk (Bite-Sized) -->
            <WizardEssenceCard
            gateNum="Tor I"
            gateTitle="Kosmisches Fundament & Gestirnskräfte"
            icon="🌌"
            coreEssence={`Sonne in ${chart.synthesis.sun.planet.sign.name} (${chart.synthesis.sun.planet.degreeString}) und Aszendent in ${chart.housesResult.angles.ascendant.sign.name} bilden deinen unverwechselbaren kosmischen Wesenskern.`}
            actionLever="Verbinde die bewusste Schöpferkraft deiner Sonne mit dem spontanen Seelentor deines Aszendenten für maximale Authentizität."
            dailyImpulse="Achte heute bei deiner ersten Begegnung auf deinen spontanen Impuls – das ist die lebendige Kraft deines Aszendenten."
          />

          <!-- Hauptpunkt: Kompakte Persönlichkeits-Zusammenfassung -->
          <PersonalitySummarySection chart={chart} />
      
          <!-- Main Chart Section: Radix Wheel & Overview -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left / Center: Interactive Radix Wheel (7 Cols) -->
        <div class="lg:col-span-7 cosmic-glass rounded-3xl p-6 md:p-7 border border-white/15 shadow-2xl flex flex-col items-center cosmic-corner-accent">
          <div class="w-full flex items-center justify-between border-b border-white/10 pb-4 mb-2">
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-lg border border-amber-500/40">
                ✦
              </span>
              <div>
                <h2 class="text-lg font-bold text-white">Das Kosmische Radix-Rad</h2>
                <p class="text-[11px] text-slate-400">Interaktive Gestirns- & Aspekt-Projektion</p>
              </div>
            </div>
            <span class="text-xs text-amber-300 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/30">
              {houseSystem === 'placidus' ? 'Placidus Häuser' : 'Equal Houses'}
            </span>
          </div>

          <RadixWheel chart={chart} />

          <div class="mt-4 p-3.5 rounded-2xl bg-black/40 border border-white/10 text-center text-xs text-slate-300 max-w-xl">
            <p>💡 <span class="font-semibold text-amber-300">Interaktion:</span> Fahre mit der Maus über ein Planetensymbol oder eine Aspektlinie im Zentrum, um verbundene Kraftströme hervorzuheben.</p>
          </div>
        </div>

        <!-- Right: Balance & Key Angles (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
          <ElementBalance balance={chart.balance} />

          <!-- Key Cardinal Angles Card -->
          <div class="cosmic-glass rounded-3xl p-6 border border-white/15 shadow-2xl space-y-4 cosmic-corner-accent">
            <div class="flex items-center gap-2.5 border-b border-white/10 pb-3">
              <span class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-300 flex items-center justify-center font-bold text-base border border-cyan-500/40">
                ❖
              </span>
              <div>
                <h3 class="text-base font-bold text-slate-100">Die 4 Kardinalen Achsen</h3>
                <p class="text-[11px] text-slate-400">Eckpfeiler deiner irdischen Existenz</p>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
              <div id="cardAC" class="p-3.5 rounded-2xl bg-white/[0.03] border border-cyan-500/30 space-y-1 hover:bg-cyan-500/5 transition-all">
                <div class="font-bold text-cyan-300 flex items-center gap-1">
                  <span>AC</span> Aszendent (1. Haus)
                </div>
                <div class="text-white font-semibold">{chart.housesResult.angles.ascendant.sign.name} ({chart.housesResult.angles.ascendant.degreeString})</div>
                <div class="text-slate-400 text-[11px]">Auftreten & Seelentor</div>
              </div>

              <div id="cardMC" class="p-3.5 rounded-2xl bg-white/[0.03] border border-amber-500/30 space-y-1 hover:bg-amber-500/5 transition-all">
                <div class="font-bold text-amber-300 flex items-center gap-1">
                  <span>MC</span> Medium Coeli (10. Haus)
                </div>
                <div class="text-white font-semibold">{chart.housesResult.angles.midheaven.sign.name} ({chart.housesResult.angles.midheaven.degreeString})</div>
                <div class="text-slate-400 text-[11px]">Berufung & Lebensziel</div>
              </div>

              <div id="cardDC" class="p-3.5 rounded-2xl bg-white/[0.03] border border-rose-500/30 space-y-1 hover:bg-rose-500/5 transition-all">
                <div class="font-bold text-rose-300 flex items-center gap-1">
                  <span>DC</span> Deszendent (7. Haus)
                </div>
                <div class="text-white font-semibold">{chart.housesResult.angles.descendant.sign.name} ({chart.housesResult.angles.descendant.degreeString})</div>
                <div class="text-slate-400 text-[11px]">Begegnung & Partner</div>
              </div>

              <div id="cardIC" class="p-3.5 rounded-2xl bg-white/[0.03] border border-indigo-500/30 space-y-1 hover:bg-indigo-500/5 transition-all">
                <div class="font-bold text-indigo-300 flex items-center gap-1">
                  <span>IC</span> Imum Coeli (4. Haus)
                </div>
                <div class="text-white font-semibold">{chart.housesResult.angles.imumCoeli.sign.name} ({chart.housesResult.angles.imumCoeli.degreeString})</div>
                <div class="text-slate-400 text-[11px]">Wurzeln & Seelenheimat</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Detailed Planetary Table & Aspect Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7">
          <PlanetCard planets={chart.planets} />
        </div>
        <div class="lg:col-span-5">
          <AspectMatrix aspects={chart.aspects} />
        </div>
      </div>

      <!-- Tab Next Navigation Banner (Tor I -> Tor II) -->
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-900/80 border border-white/10 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4 no-print">
        <div class="space-y-1 text-center sm:text-left">
          <div class="text-[10px] uppercase font-bold tracking-widest text-amber-400 font-tech">Nächste Seelenebene</div>
          <h4 class="text-base sm:text-lg font-bold text-white">Tor II: Die 3 Lebens-Säulen (Liebe, Beruf & Erfüllung)</h4>
          <p class="text-xs text-slate-300">Erfahre, wie deine Gestirne in Liebe und Karriere wirksam werden.</p>
        </div>
        <button
          type="button"
          class="tab-nav-btn px-6 py-3 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-bold text-xs flex items-center gap-2 hover:scale-[1.02] transition-all cursor-pointer shadow-md shrink-0"
          data-switch-to="pillars"
        >
          <span>Weiter zu Tor II</span>
          <span class="text-base">💖 →</span>
        </button>
      </div>

    </div>

    <!-- TAB 2: Die 3 Lebens-Säulen Panel (Tor II) -->
    <div id="panel-pillars" class="tab-content-panel space-y-8">
      
      <!-- Wizard Sofort-Erkenntnis Chunk -->
      <WizardEssenceCard
        gateNum="Tor II"
        gateTitle="Die 3 Lebens-Säulen (Liebe, Beruf & Erfüllung)"
        icon="💖"
        coreEssence="Deine kosmischen Energien manifestieren sich auf 3 irdischen Lebensbühnen: Herzensbeziehungen, Berufung/MC und Seelenruhe."
        actionLever="Richte deine berufliche Ausrichtung und Partnerschaftsmuster synchron an deinen tieferen Werten aus."
        dailyImpulse="Triff heute eine praktische Berufs- oder Beziehungsentscheidung im vollen Einklang mit deinem Herzen."
      />

      <LifePillarsSection chart={chart} />

      <div class="p-5 sm:p-6 rounded-2xl bg-slate-900/80 border border-white/10 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4 no-print">
        <button
          type="button"
          class="tab-nav-btn px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-300 text-xs font-semibold flex items-center gap-2 hover:bg-white/10 transition-all cursor-pointer"
          data-switch-to="radix"
        >
          <span>← Zurück zu Tor I</span>
        </button>

        <div class="text-center">
          <div class="text-[10px] uppercase font-bold tracking-widest text-amber-400 font-tech">Nächste Seelenebene</div>
          <div class="text-sm font-bold text-white">Tor III: Karmische Tore & Schicksalsachsen</div>
        </div>

        <button
          type="button"
          class="tab-nav-btn px-6 py-3 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-bold text-xs flex items-center gap-2 hover:scale-[1.02] transition-all cursor-pointer shadow-md shrink-0"
          data-switch-to="karmic"
        >
          <span>Weiter zu Tor III</span>
          <span class="text-base">☊ →</span>
        </button>
      </div>
    </div>

    <!-- TAB 3: Karmische Knoten & Tore Panel (Tor III) -->
    <div id="panel-karmic" class="tab-content-panel space-y-8">
      <!-- Wizard Sofort-Erkenntnis Chunk -->
      <WizardEssenceCard
        gateNum="Tor III"
        gateTitle="Karmische Tore & Schicksalsachsen"
        icon="☊"
        coreEssence="Die Mondknoten-Achse führt dich vom gewohnten Südknoten-Komfort zur Reifung deines Nordknotens."
        actionLever="Löse alte karmische Reaktionsschleifen auf und folge mutig dem Wachstumsimpuls deines Nordknotens."
        dailyImpulse="Verlasse heute eine bequeme Gewohnheit und wage einen mutigen Schritt in Richtung deines Seelenziels."
      />

      <KarmicNodesSection chart={chart} />

      <div class="p-5 sm:p-6 rounded-2xl bg-slate-900/80 border border-white/10 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4 no-print">
        <button
          type="button"
          class="tab-nav-btn px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-300 text-xs font-semibold flex items-center gap-2 hover:bg-white/10 transition-all cursor-pointer"
          data-switch-to="pillars"
        >
          <span>← Zurück zu Tor II</span>
        </button>

        <div class="text-center">
          <div class="text-[10px] uppercase font-bold tracking-widest text-amber-400 font-tech">Nächste Seelenebene</div>
          <div class="text-sm font-bold text-white">Tor IV: Pythagoräische Seelen-Numerologie</div>
        </div>

        <button
          type="button"
          class="tab-nav-btn px-6 py-3 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-bold text-xs flex items-center gap-2 hover:scale-[1.02] transition-all cursor-pointer shadow-md shrink-0"
          data-switch-to="numerology"
        >
          <span>Weiter zu Tor IV</span>
          <span class="text-base">🔢 →</span>
        </button>
      </div>
    </div>

    <!-- TAB 4: Seelen-Numerologie Panel (Tor IV) -->
    <div id="panel-numerology" class="tab-content-panel space-y-8">
      <!-- Wizard Sofort-Erkenntnis Chunk -->
      <WizardEssenceCard
        gateNum="Tor IV"
        gateTitle="Pythagoräische Seelen-Numerologie"
        icon="🔢"
        coreEssence={`Deine Lebenszahl ${chart.numerology.lifePath.number} (${chart.numerology.lifePath.archetype}) trägt deinen unverwechselbaren mathematischen Schwingungscode.`}
        actionLever="Nutze deinen Namenscode und deine Herzzahl als intuitiven Prüfkompass für stimmige Entscheidungen."
        dailyImpulse="Beobachte heute, welche Zahlensynchronizitäten dir im Tagesverlauf intuitiv begegnen."
      />

      <NumerologySection chart={chart} />

      <div class="p-5 sm:p-6 rounded-2xl bg-slate-900/80 border border-white/10 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4 no-print">
        <button
          type="button"
          class="tab-nav-btn px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-300 text-xs font-semibold flex items-center gap-2 hover:bg-white/10 transition-all cursor-pointer"
          data-switch-to="karmic"
        >
          <span>← Zurück zu Tor III</span>
        </button>

        <div class="text-center">
          <div class="text-[10px] uppercase font-bold tracking-widest text-amber-400 font-tech">Nächste Seelenebene</div>
          <div class="text-sm font-bold text-white">Tor V: Engelszahlen & Spiegeluhrzeiten</div>
        </div>

        <button
          type="button"
          class="tab-nav-btn px-6 py-3 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-bold text-xs flex items-center gap-2 hover:scale-[1.02] transition-all cursor-pointer shadow-md shrink-0"
          data-switch-to="angel_numbers"
        >
          <span>Weiter zu Tor V</span>
          <span class="text-base">🕊️ →</span>
        </button>
      </div>
