---
import Layout from '../layouts/Layout.astro';
import BirthForm from '../components/ui/BirthForm.astro';
import FolderTabs from '../components/ui/FolderTabs.astro';
import SoulJourneyProgress from '../components/ui/SoulJourneyProgress.astro';
import SoulWizardNavigator from '../components/ui/SoulWizardNavigator.astro';
import SoulQuestionCompass from '../components/ui/SoulQuestionCompass.astro';
import BirkenbihlDecoder from '../components/ui/BirkenbihlDecoder.astro';
import HeroSeelenbuchHeader from '../components/ui/HeroSeelenbuchHeader.astro';
import GatePanelsContainer from '../components/gates/GatePanelsContainer.astro';
import EeatTrustSection from '../components/ui/EeatTrustSection.astro';
import GseoFaqSection from '../components/ui/GseoFaqSection.astro';
import { DashboardController } from '../lib/controllers/dashboardController';

// Resolve full view model through DTO boundary & controller
const viewModel = DashboardController.handleRequest(Astro.url.searchParams);
const { hasExplicitQuery, chartInput, chart, personalitySummary, hdChart } = viewModel;
const { birthDate, birthTime, cityName, houseSystem } = chartInput;
const userName = chartInput.name || '';

const formattedBirthDate = new Date(birthDate + 'T00:00:00').toLocaleDateString('de-DE', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
---

<Layout title={`Ψ-NEXUS Seelen-Matrix | ${userName ? userName + ' • ' : ''}${chart.synthesis.sun.planet.sign.name}`}>
  <div class="boxed-canvas py-6 sm:py-8 space-y-8">
    
    <!-- Hero / Title Section in Boxed Frame -->
    <HeroSeelenbuchHeader
      hasExplicitQuery={hasExplicitQuery}
      userName={userName}
      chart={chart}
      personalitySummary={personalitySummary}
      formattedBirthDate={formattedBirthDate}
      birthTime={birthTime}
      cityName={cityName}
      houseSystem={houseSystem}
    />

    <!-- Stage 1: Input Form Section (Eingeben oder Auswählen) -->
    <div id="form-section" class="relative z-40 overflow-visible">
      <BirthForm initialValues={chartInput} hasActiveProfile={hasExplicitQuery} />
    </div>

    <!-- Stage 2: Soul Question Compass ("Und dann fragen") -->
    <div id="question-section" class={hasExplicitQuery ? '' : 'hidden'}>
      <SoulQuestionCompass userName={userName || 'Edle Seele'} sunSign={chart.synthesis.sun.planet.sign.name} />
    </div>

    <!-- Stage 3: Complete Soul Dossier (Revealed when a profile is active) -->
    <div id="soulDossierContainer" class={hasExplicitQuery ? 'space-y-8 min-w-0 w-full' : 'hidden space-y-8 min-w-0 w-full'}>
      <div id="soulDossierWrapper" class="space-y-6">
        <SoulJourneyProgress activeStep="radix" />
        <SoulWizardNavigator activeGate="radix" />
        <FolderTabs activeTab="radix" />
      </div>

      <!-- Full-Width Main Dossier Content Panels (All 12 Gates) -->
      <GatePanelsContainer chart={chart} hdChart={hdChart} houseSystem={houseSystem} />

      <!-- Birkenbihl Instant Decoder Widget (Wissens-Referenz & Glossar) -->
      <div id="decoderToggleHeader" class="mt-8">
        <BirkenbihlDecoder />
      </div>
    </div>

    <!-- GSEO Knowledge Matrix & AI-Quotable FAQ Section -->
    <div class="mt-8">
      <GseoFaqSection />
    </div>

    <!-- E-E-A-T Quality, Methodology & Trust Framework (Subtle Footer Anchor) -->
    <div class="mt-8">
      <EeatTrustSection />
    </div>

  </div>

  <!-- Client-Side Tab & Calculation Controller -->
  <script>
    import { initTabController } from '../scripts/controllers/tabController';
    initTabController();
  </script>
</Layout>
