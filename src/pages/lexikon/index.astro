---
import Layout from '../../layouts/Layout.astro';

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: 'https://psi-nexus.org/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Esoterik & Astrologie Lexikon',
      item: 'https://psi-nexus.org/lexikon/'
    }
  ]
};

const TOPICS = [
  {
    slug: '/lexikon/aszendent',
    title: 'Der Aszendent (AC) & Die 12 Tore',
    badge: 'Seelentor & Wesenskern',
    icon: '↑',
    color: 'border-cyan-500/40 text-cyan-300',
    description: 'Das aufsteigende Tierkreiszeichen am Osthorizont: Bedeutung, Herrscherplaneten und das Zusammenspiel mit dem Sonnenzeichen in allen 12 Zeichen.',
    keywords: ['Aszendent berechnen', '12 Aszendenten', 'Seelentor', 'AC Herrscher']
  },
  {
    slug: '/lexikon/lebenszahlen',
    title: 'Pythagoräische Lebenszahlen (1–9 & Meisterzahlen)',
    badge: 'Numerologie & Lebensplan',
    icon: '🔢',
    color: 'border-purple-500/40 text-purple-300',
    description: 'Die kosmische Schwingung deines Geburtsdatums: Exakte Berechnung, Seelenauftrag, karmische Lektionen und Meisterzahlen 11, 22, 33.',
    keywords: ['Lebenszahl berechnen', 'Meisterzahl 11 22 33', 'Pythagoras', 'Quersumme']
  },
  {
    slug: '/lexikon/sieben-strahlen',
    title: 'Die Sieben Kosmischen Strahlen',
    badge: 'Esoterische Psychologie',
    icon: '✦',
    color: 'border-amber-500/40 text-amber-300',
    description: 'Die 7 Schöpfungsqualitäten nach Alice Bailey & Helena Blavatsky: Seelenstrahl, Persönlichkeitsstrahl und evolutionäre Bewusstseinsstufen.',
    keywords: ['Sieben Strahlen', 'Seelenstrahl', 'Alice Bailey', 'Esoterische Astrologie']
  }
];
---

<Layout
  title="Ψ-NEXUS Lexikon | Esoterik, Astrologie & Ephemeriden-Kompendium"
  description="Das fundierte Wissenskompendium für Himmelsmechanik, Placidus-Häusersysteme, Aszendenten, pythagoräische Lebenszahlen und die Sieben Kosmischen Strahlen."
>
  <!-- Schema.org Breadcrumbs Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />

  <div class="boxed-canvas py-8 space-y-10 max-w-6xl mx-auto px-4">
    
    <!-- Hero / Header -->
    <div class="boxed-frame text-center space-y-4 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full birkenbihl-badge text-amber-300 text-xs font-bold uppercase tracking-widest shadow-md">
        <span>📖</span>
        <span>Ψ-NEXUS Wissens-Archiv & Silo-Hub</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
        Esoterisches & Astronomisches <span class="cosmic-gold-gradient">Kompendium</span>
      </h1>

      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto font-lato leading-relaxed">
        Wissenschaftliche Himmelsmechanik trifft auf C.G. Jungs Archetypenlehre und die Vera F. Birkenbihl Neurodidaktik. Entschlüssele die fundamentalen Gesetzmäßigkeiten von Kosmos und Seele.
      </p>

      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 text-amber-300 text-xs font-bold transition-all shadow-sm"
        >
          <span>← Zurück zum Horoskop-Rechner</span>
        </a>
      </div>
    </div>

    <!-- Topic Grid (Link Silos) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {TOPICS.map(topic => (
        <a
          href={topic.slug}
          class="cosmic-glass rounded-3xl p-6 border border-white/15 hover:border-amber-400/50 transition-all duration-300 flex flex-col justify-between space-y-4 group shadow-xl hover:-translate-y-1"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class={`w-12 h-12 rounded-2xl bg-slate-900/90 border ${topic.color} flex items-center justify-center text-2xl font-bold`}>
                {topic.icon}
              </span>
              <span class="text-[10px] uppercase font-mono tracking-widest text-slate-400">
                {topic.badge}
              </span>
            </div>

            <h2 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors font-cinzel">
              {topic.title}
            </h2>

            <p class="text-xs text-slate-300 font-lato leading-relaxed">
              {topic.description}
            </p>
          </div>

          <div class="pt-4 border-t border-white/10 flex items-center justify-between">
            <div class="flex flex-wrap gap-1">
              {topic.keywords.slice(0, 2).map(kw => (
                <span class="text-[10px] px-2 py-0.5 rounded bg-white/5 text-slate-400 font-tech">
                  #{kw}
                </span>
              ))}
            </div>
            <span class="text-amber-400 text-xs font-bold font-mono group-hover:translate-x-1 transition-transform">
              Lesen ➔
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Cicero 7Q Knowledge Matrix Box -->
    <div class="p-6 rounded-3xl cosmic-glass border border-amber-500/30 space-y-4">
      <div class="flex items-center gap-3 border-b border-white/10 pb-3">
        <span class="text-2xl">🏛️</span>
        <div>
          <h3 class="text-base font-bold text-white font-cinzel">Radikale Objektivität & Wissens-Standards</h3>
          <p class="text-[11px] text-slate-400">Alle Definitionen entsprechen den wissenschaftlichen Ephemeriden-Theorien (VSOP87 / IAU 2006).</p>
        </div>
      </div>
      <p class="text-xs text-slate-300 font-lato leading-relaxed">
        Gemäß der NEXUS Supremacy-Spezifikation sind alle Textbausteine frei von manipulativen Werbeversprechen oder fatalistischer Wahrsagerei. Wir vermitteln reines, überprüfbares Strukturwissen zur persönlichen Bewusstseinsentfaltung.
      </p>
    </div>

  </div>
</Layout>
