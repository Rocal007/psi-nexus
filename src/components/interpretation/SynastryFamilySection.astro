---
import { generateNatalChart, type CompleteNatalChart } from '../../lib/astrology/engine';
import { calculateSynastry, calculateFamilyMatrix } from '../../lib/astrology/synastry';
import PartnerMatchingCard from './synastry/PartnerMatchingCard.astro';
import CompositeChartCard from './synastry/CompositeChartCard.astro';
import FamilyClusterCard from './synastry/FamilyClusterCard.astro';

interface Props {
  chart: CompleteNatalChart;
}

const { chart } = Astro.props;

const partnerChartMock = generateNatalChart({
  name: 'Seelenpartner (Muster-Vergleich)',
  birthDate: '1992-03-12',
  birthTime: '08:45',
  cityName: 'Salzburg',
  latitude: 47.8095,
  longitude: 13.055,
  timezone: 'Europe/Vienna',
  houseSystem: chart.input.houseSystem || 'placidus'
});

const initialSynastry = calculateSynastry(chart, partnerChartMock);
const initialFamily = calculateFamilyMatrix([chart, partnerChartMock]);
---

<div class="space-y-10" id="synastryFamilySectionRoot">
  <!-- Section Title -->
  <div class="text-center space-y-3 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full birkenbihl-badge text-rose-300 text-xs font-semibold uppercase tracking-wider">
      <span>💞</span> Tor XI: Beziehungs- & Familien-Alchemie <span>👨‍👩‍👧‍👦</span>
    </div>
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-black text-white tracking-tight">
      Partner-Synastrie & Familien-Karmamatrix
    </h2>
    <p class="text-slate-300 text-sm leading-relaxed">
      Ergründe die energetische Alchemie zwischen zwei Seelen: Inter-Aspekte, Komposit-Horoskop (das gemeinsame Dritte Wesen), Seelenverträge sowie die kollektive Dynamik eurer gesamten Familie.
    </p>
  </div>

  <!-- Interactive Mode Switch & Profile Selectors -->
  <div class="cosmic-glass rounded-3xl p-6 md:p-7 border border-white/15 shadow-2xl space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-5">
      <div class="flex items-center gap-2 bg-slate-950/80 p-1.5 rounded-2xl border border-white/10">
        <button type="button" id="synastryModePartnerBtn" class="px-5 py-2 rounded-xl text-xs font-bold transition-all bg-gradient-to-r from-pink-500 to-rose-600 text-white shadow-[0_0_15px_rgba(236,72,153,0.4)] cursor-pointer">
          👫 Partner-Synastrie (2 Personen)
        </button>
        <button type="button" id="synastryModeFamilyBtn" class="px-5 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition-all cursor-pointer">
          👨‍👩‍👧‍👦 Familien-Matrix (Alle Profile)
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button type="button" id="btnCalculateSynastry" class="hidden text-xs font-bold text-pink-300 px-3 py-1.5 rounded-xl bg-pink-500/10 border border-pink-500/30 hover:bg-pink-500/20 transition-all cursor-pointer">
          Berechnen
        </button>
        <a href="#form-section" class="text-xs font-bold text-amber-300 hover:text-amber-200 flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-amber-500/10 border border-amber-500/30 transition-all hover:bg-amber-500/20">
          <span>+</span> Neues Profil hinzufügen
        </a>
      </div>
    </div>

    <!-- Partner Selectors Row -->
    <div id="partnerSelectorsRow" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label class="block text-xs font-bold uppercase tracking-wider text-amber-300">Person 1 (Hauptprofil)</label>
        <select id="synastrySelectPersonA" class="w-full bg-slate-950 text-white px-3.5 py-2.5 rounded-xl border border-amber-500/30 focus:outline-none focus:border-amber-400 text-xs font-medium">
          <option value="active">{chart.input.name || 'Aktives Profil'}</option>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-bold uppercase tracking-wider text-pink-300">Person 2 (Partner / Vergleichsperson)</label>
        <select id="synastryPartnerBSelect" name="synastrySelectPersonB" class="w-full bg-slate-950 text-white px-3.5 py-2.5 rounded-xl border border-pink-500/30 focus:outline-none focus:border-pink-400 text-xs font-medium">
          <option value="partner_default">Seelenpartner (Archetyp)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- PARTNER SYNASTRY VIEW CONTAINER -->
  <div id="partnerSynastryView" class="space-y-8">
    <PartnerMatchingCard initialSynastry={initialSynastry} />
    <CompositeChartCard initialSynastry={initialSynastry} />
  </div>

  <!-- FAMILY & GROUP MATRIX VIEW CONTAINER -->
  <div id="familyMatrixView" class="space-y-8 hidden">
    <FamilyClusterCard initialFamily={initialFamily} />
  </div>
</div>

<script src="../../scripts/controllers/synastryController.ts"></script>
