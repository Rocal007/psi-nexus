---
import type { CompleteNatalChart } from '../../lib/astrology/engine';

interface Props {
  chart: CompleteNatalChart;
}

const { chart } = Astro.props;
const { karmicNodes } = chart;
---

<div class="space-y-10">
  <!-- Section Header -->
  <div class="text-center space-y-3 max-w-2xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full birkenbihl-badge text-purple-300 text-xs font-semibold uppercase tracking-wider">
      <span>☊</span> Tor III: Karmische Tore & Schicksalsachsen <span>☋</span>
    </div>
    <h2 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
      Seelen-Evolution & Höhere Schicksalstore
    </h2>
    <p class="text-slate-300 text-sm leading-relaxed">
      Woher kommt deine Seele (Südknoten), und wohin führt dein mutiger Evolutionsschritt (Nordknoten)? Erfahre die Geheimnisse deines Glückspunkts und deiner Synchronizitäts-Portale.
    </p>
  </div>

  <!-- Special Nodes Grid Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
    
    <!-- 1. North Node -->
    <div class="cosmic-glass rounded-3xl p-5 border border-amber-500/40 flex flex-col justify-between space-y-4 shadow-xl relative overflow-hidden cosmic-corner-accent">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-2xl bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-xl border border-amber-500/40 shadow-[0_0_12px_rgba(234,179,8,0.3)]">
              ☊
            </span>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-amber-400">Nordknoten (Rahu)</span>
              <div class="text-xs text-slate-300 font-medium">Der Seelen-Kompass</div>
            </div>
          </div>
          <span id="knNorthDeg" class="text-xs font-mono text-slate-400 bg-white/5 px-2 py-0.5 rounded">{karmicNodes.northNode.degreeString}</span>
        </div>

        <h4 id="knNorthTitle" class="text-base font-bold text-white">
          {karmicNodes.northNode.sign.name} ({karmicNodes.northNode.house}. Haus)
        </h4>

        <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/25 text-xs text-slate-200 space-y-1">
          <div class="font-bold text-amber-300 flex items-center gap-1">
            <span>🌟</span> Größtes Wachstumspotenzial:
          </div>
          <p id="knNorthPot" class="leading-relaxed">{karmicNodes.northNode.potentialDescription}</p>
        </div>
      </div>

      <div class="text-[11px] text-amber-300/95 italic pt-2.5 border-t border-white/10">
        <span class="font-semibold">Konkrete Seelen-Aktion:</span> <span id="knNorthAct">{karmicNodes.northNode.actionRecommendation}</span>
      </div>
    </div>

    <!-- 2. South Node -->
    <div class="cosmic-glass rounded-3xl p-5 border border-rose-500/40 flex flex-col justify-between space-y-4 shadow-xl relative overflow-hidden cosmic-corner-accent">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-2xl bg-rose-500/20 text-rose-300 flex items-center justify-center font-bold text-xl border border-rose-500/40 shadow-[0_0_12px_rgba(244,63,94,0.3)]">
              ☋
            </span>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-rose-400">Südknoten (Ketu)</span>
              <div class="text-xs text-slate-300 font-medium">Alte Komfortzone</div>
            </div>
          </div>
          <span id="knSouthDeg" class="text-xs font-mono text-slate-400 bg-white/5 px-2 py-0.5 rounded">{karmicNodes.southNode.degreeString}</span>
        </div>

        <h4 id="knSouthTitle" class="text-base font-bold text-white">
          {karmicNodes.southNode.sign.name} ({karmicNodes.southNode.house}. Haus)
        </h4>

        <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-xs text-slate-200 space-y-1">
          <div class="font-bold text-rose-300 flex items-center gap-1">
            <span>⚠️</span> Karmisches Loslass-Thema:
          </div>
          <p id="knSouthChal" class="leading-relaxed">{karmicNodes.southNode.lifeChallengeDescription}</p>
        </div>
      </div>

      <div class="text-[11px] text-rose-300/95 italic pt-2.5 border-t border-white/10">
        <span class="font-semibold">Karmische Weisheit:</span> <span id="knSouthAct">{karmicNodes.southNode.actionRecommendation}</span>
      </div>
    </div>

    <!-- 3. Part of Fortune -->
    <div class="cosmic-glass-gold rounded-3xl p-5 border border-yellow-500/40 flex flex-col justify-between space-y-4 shadow-xl relative overflow-hidden cosmic-corner-accent">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-2xl bg-yellow-500/20 text-yellow-300 flex items-center justify-center font-bold text-xl border border-yellow-500/40 shadow-[0_0_12px_rgba(234,179,8,0.3)]">
              ⊕
            </span>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-yellow-400">Glückspunkt</span>
              <div class="text-xs text-slate-300 font-medium">Pars Fortunae</div>
            </div>
          </div>
          <span id="knFortDeg" class="text-xs font-mono text-slate-400 bg-white/5 px-2 py-0.5 rounded">{karmicNodes.partOfFortune.degreeString}</span>
        </div>

        <h4 id="knFortTitle" class="text-base font-bold text-white">
          {karmicNodes.partOfFortune.sign.name} ({karmicNodes.partOfFortune.house}. Haus)
        </h4>

        <div class="p-3.5 rounded-2xl bg-yellow-500/10 border border-yellow-500/25 text-xs text-slate-200 space-y-1">
          <div class="font-bold text-yellow-300 flex items-center gap-1">
            <span>✨</span> Quelle der Fülle & Freude:
          </div>
          <p id="knFortPot" class="leading-relaxed">{karmicNodes.partOfFortune.potentialDescription}</p>
        </div>
      </div>

      <div class="text-[11px] text-yellow-300/95 italic pt-2.5 border-t border-white/10">
        <span class="font-semibold">Aktivierung im Alltag:</span> <span id="knFortAct">{karmicNodes.partOfFortune.actionRecommendation}</span>
      </div>
    </div>

    <!-- 4. Vertex (Schicksalstor) -->
    <div class="cosmic-glass rounded-3xl p-5 border border-purple-500/40 flex flex-col justify-between space-y-4 shadow-xl relative overflow-hidden cosmic-corner-accent">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-2xl bg-purple-500/20 text-purple-300 flex items-center justify-center font-bold text-sm border border-purple-500/40 shadow-[0_0_12px_rgba(168,85,247,0.3)]">
              Vx
            </span>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-purple-400">Vertex</span>
              <div class="text-xs text-slate-300 font-medium">Schicksalstor</div>
            </div>
          </div>
          <span id="knVertDeg" class="text-xs font-mono text-slate-400 bg-white/5 px-2 py-0.5 rounded">{karmicNodes.vertex.degreeString}</span>
        </div>

        <h4 id="knVertTitle" class="text-base font-bold text-white">
          {karmicNodes.vertex.sign.name} ({karmicNodes.vertex.house}. Haus)
        </h4>

        <div class="p-3.5 rounded-2xl bg-purple-500/10 border border-purple-500/25 text-xs text-slate-200 space-y-1">
          <div class="font-bold text-purple-300 flex items-center gap-1">
            <span>🔮</span> Schicksalhafte Wendepunkte:
          </div>
          <p id="knVertPot" class="leading-relaxed">{karmicNodes.vertex.potentialDescription}</p>
        </div>
      </div>

      <div class="text-[11px] text-purple-300/95 italic pt-2.5 border-t border-white/10">
        <span class="font-semibold">Führung durch Fügung:</span> <span id="knVertAct">{karmicNodes.vertex.actionRecommendation}</span>
      </div>
    </div>

  </div>

  <!-- Thematic Focus Clusters (Lebensthemen-Matrix) -->
  <div class="cosmic-glass rounded-3xl p-6 md:p-8 border border-white/10 space-y-6 shadow-2xl relative">
    <div class="flex items-center gap-3 border-b border-white/10 pb-4">
      <span class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-lg border border-amber-500/30">
        ❖
      </span>
      <div>
        <h3 class="text-xl font-bold text-white">Die 4 Großen Lebensthemen-Cluster (Fokus-Matrix)</h3>
        <p class="text-xs text-slate-400">Wie deine karmischen Achsen mit den Planetenmustern in Wechselwirkung treten</p>
      </div>
    </div>

    <div id="thematicClustersContainer" class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {karmicNodes.thematicHighlights.map(cl => (
        <div class={`p-5 rounded-2xl border ${cl.color} space-y-3 bg-slate-950/60 hover:bg-slate-900/80 transition-all`}>
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-300">{cl.category}</span>
            <div class="flex items-center gap-1.5 text-[11px] font-mono text-slate-400">
              {cl.pointsInvolved.map(pt => (
                <span class="px-2 py-0.5 rounded bg-black/50 border border-white/10">{pt}</span>
              ))}
            </div>
          </div>

          <h4 class="text-base font-bold text-white">{cl.headline}</h4>

          <p class="text-xs md:text-sm text-slate-300 leading-relaxed">
            {cl.coreInsight}
          </p>

          <div class="p-3.5 rounded-xl bg-black/40 border border-white/10 text-xs space-y-1">
            <div class="font-bold text-amber-300 flex items-center gap-1">
              <span>✦</span> Praktischer Seelen-Fokus:
            </div>
            <div class="text-slate-200">{cl.practicalAction}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
