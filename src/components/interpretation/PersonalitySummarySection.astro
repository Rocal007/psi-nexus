---
// Neurodidactic Personality Summary & Core Soul Essence Dossier
import type { CompleteNatalChart } from '../../lib/astrology/engine';
import { generatePersonalitySummary } from '../../lib/astrology/personalitySynthesis';

interface Props {
  chart: CompleteNatalChart;
}

const { chart } = Astro.props;
const p = generatePersonalitySummary(chart);
const personName = chart.input.name || 'Edle Seele';
---

<section id="personalitySummarySection" class="cosmic-glass-gold rounded-3xl p-6 md:p-8 border border-amber-500/40 shadow-2xl space-y-7 relative overflow-hidden cosmic-corner-accent">
  <!-- Glowing Background Accent -->
  <div class="absolute -right-16 -top-16 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- 1. Header & Personality Archetype Banner -->
  <div class="space-y-3 relative z-10 border-b border-white/10 pb-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-amber-400 to-yellow-500 text-slate-950 flex items-center justify-center font-black text-lg shadow-[0_0_20px_rgba(234,179,8,0.4)]">
          👑
        </span>
        <div>
          <span class="text-[10px] uppercase font-bold tracking-widest text-amber-400 font-tech block">Hauptpunkt: Seelen-Synthese</span>
          <h2 class="text-xl md:text-2xl font-black text-white font-cinzel">
            Persönlichkeits-Essenz von <span id="personalityPersonName" class="text-amber-300">{personName}</span>
          </h2>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-200 text-xs font-semibold flex items-center gap-1.5 font-tech">
          <span>✦</span>
          <span id="personalityElementTag">{chart.balance.dominantElement}-Dominanz</span>
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-purple-500/15 border border-purple-500/30 text-purple-200 text-xs font-semibold flex items-center gap-1.5 font-tech">
          <span>🔢</span>
          <span id="personalityLifePathTag">Lebensweg {chart.numerology.lifePath.number}</span>
        </span>
      </div>
    </div>

    <!-- Archetype Title Badge -->
    <div class="p-4 rounded-2xl bg-slate-950/60 border border-amber-500/25 space-y-2">
      <div class="text-xs uppercase font-bold tracking-wider text-amber-400 flex items-center gap-1.5 font-tech">
        <span>🌟</span>
        <span>Kosmischer Seelen-Archetyp:</span>
      </div>
      <div id="personalityArchetypeTitle" class="text-base md:text-lg font-bold text-white leading-snug">
        {p.archetypeName}
      </div>
      <p id="personalityShortEssence" class="text-xs md:text-sm text-slate-200 leading-relaxed font-lato">
        {p.shortEssence}
      </p>
    </div>

    <!-- Personal Mantra Quote -->
    <div class="p-3.5 rounded-xl bg-amber-500/5 border-l-4 border-amber-400 text-slate-200">
      <div class="text-[10px] uppercase font-bold tracking-widest text-amber-400/80 mb-1 font-tech">Persönlicher Seelen-Leitsatz:</div>
      <blockquote id="personalityMantraText" class="font-cormorant italic text-base md:text-lg text-amber-100 font-medium tracking-wide">
        {p.personalityMantra}
      </blockquote>
    </div>
  </div>

  <!-- 2. The 4 Core Identity Pillars (Grid) -->
  <div class="space-y-3 relative z-10">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2 font-tech">
        <span>🏛️</span>
        <span>Die 4 Säulen deiner Identität</span>
      </h3>
      <span class="text-[10px] text-slate-400 font-tech">Sonne • Mond • Aszendent • Merkur</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="personalityPillarsContainer">
      <!-- Pillar 1: Sun (Wesenskern) -->
      <div class="p-4 rounded-2xl bg-slate-900/70 border border-amber-500/30 space-y-2 hover:border-amber-400/60 transition-all shadow-md">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
          <div class="flex items-center gap-1.5">
            <span class="text-amber-400 text-base font-bold">☉</span>
            <span class="text-xs font-bold text-white uppercase font-tech">Wesenskern</span>
          </div>
          <span class="text-xs font-bold text-amber-300 font-tech" id="pillarSunSign">{p.corePillars.sunPillar.sign}</span>
        </div>
        <p class="text-xs text-slate-200 leading-relaxed font-lato" id="pillarSunDesc">{p.corePillars.sunPillar.description}</p>
        <div class="pt-1 text-[11px] text-amber-200/90 font-medium">
          <strong>Stärke:</strong> <span id="pillarSunTrait">{p.corePillars.sunPillar.keyTrait}</span>
        </div>
      </div>

      <!-- Pillar 2: Moon (Seelenwelt) -->
      <div class="p-4 rounded-2xl bg-slate-900/70 border border-indigo-500/30 space-y-2 hover:border-indigo-400/60 transition-all shadow-md">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
          <div class="flex items-center gap-1.5">
            <span class="text-indigo-400 text-base font-bold">☽</span>
            <span class="text-xs font-bold text-white uppercase font-tech">Seelenwelt</span>
          </div>
          <span class="text-xs font-bold text-indigo-300 font-tech" id="pillarMoonSign">{p.corePillars.moonPillar.sign}</span>
        </div>
        <p class="text-xs text-slate-200 leading-relaxed font-lato" id="pillarMoonDesc">{p.corePillars.moonPillar.description}</p>
        <div class="pt-1 text-[11px] text-indigo-200/90 font-medium">
          <strong>Bedürfnis:</strong> <span id="pillarMoonNeeds">{p.corePillars.moonPillar.needs}</span>
        </div>
      </div>

      <!-- Pillar 3: Ascendant (Auftreten) -->
      <div class="p-4 rounded-2xl bg-slate-900/70 border border-cyan-500/30 space-y-2 hover:border-cyan-400/60 transition-all shadow-md">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
          <div class="flex items-center gap-1.5">
            <span class="text-cyan-400 text-base font-bold">↑</span>
            <span class="text-xs font-bold text-white uppercase font-tech">Seelentor (AC)</span>
          </div>
          <span class="text-xs font-bold text-cyan-300 font-tech" id="pillarAscSign">{p.corePillars.ascendantPillar.sign}</span>
        </div>
        <p class="text-xs text-slate-200 leading-relaxed font-lato" id="pillarAscDesc">{p.corePillars.ascendantPillar.description}</p>
        <div class="pt-1 text-[11px] text-cyan-200/90 font-medium">
          <strong>Erster Eindruck:</strong> <span id="pillarAscImpression">{p.corePillars.ascendantPillar.firstImpression}</span>
        </div>
      </div>

      <!-- Pillar 4: Mercury (Denken) -->
      <div class="p-4 rounded-2xl bg-slate-900/70 border border-purple-500/30 space-y-2 hover:border-purple-400/60 transition-all shadow-md">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
          <div class="flex items-center gap-1.5">
            <span class="text-purple-400 text-base font-bold">☿</span>
            <span class="text-xs font-bold text-white uppercase font-tech">Denkstil & Verstand</span>
          </div>
          <span class="text-xs font-bold text-purple-300 font-tech" id="pillarMindSign">{p.corePillars.mindPillar.sign}</span>
        </div>
        <p class="text-xs text-slate-200 leading-relaxed font-lato" id="pillarMindDesc">{p.corePillars.mindPillar.description}</p>
        <div class="pt-1 text-[11px] text-purple-200/90 font-medium">
          <strong>Stil:</strong> <span id="pillarMindStyle">{p.corePillars.mindPillar.thinkingStyle}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Superpowers & Growth Keys Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 relative z-10 pt-2">
    <!-- Top 3 Superpowers -->
    <div class="p-5 rounded-2xl bg-slate-950/60 border border-amber-500/30 space-y-3">
      <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
        <div class="flex items-center gap-2">
          <span class="text-amber-400 text-lg">✨</span>
          <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300 font-tech">Deine 3 Größten Seelen-Superkräfte</h4>
        </div>
      </div>
      <div class="space-y-2.5" id="personalitySuperpowersList">
        {p.superpowers.map(s => (
          <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-white/[0.03] border border-white/5">
            <span class="text-base shrink-0 mt-0.5">{s.icon}</span>
            <div class="text-xs leading-relaxed">
              <span class="font-bold text-white block">{s.name}</span>
              <span class="text-slate-300 font-lato">{s.detail}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Growth & Shadow Mastery -->
    <div class="p-5 rounded-2xl bg-slate-950/60 border border-purple-500/30 space-y-3">
      <div class="flex items-center justify-between border-b border-white/10 pb-2.5">
        <div class="flex items-center gap-2">
          <span class="text-purple-400 text-lg">🌱</span>
          <h4 class="text-xs font-bold uppercase tracking-wider text-purple-300 font-tech">Seelen-Wachstum & Schatten-Meisterung</h4>
        </div>
      </div>
      <div class="space-y-2.5" id="personalityGrowthList">
        {p.growthKeys.map(g => (
          <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/5 space-y-1 text-xs leading-relaxed">
            <div class="flex items-center gap-1.5 font-semibold text-rose-300">
              <span>{g.icon}</span>
              <span>Herausforderung: {g.challenge}</span>
            </div>
            <div class="text-emerald-300 pl-5 font-medium font-lato">
              ➔ <strong>Schlüssel:</strong> {g.masteryKey}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 4. Birkenbihl Neurodidactic Communication Code -->
  <div class="p-4 rounded-2xl bg-gradient-to-r from-slate-950/80 via-slate-900/80 to-slate-950/80 border border-white/10 space-y-2 relative z-10">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300 font-tech">
        <span>🤝</span>
        <span>Birkenbihl-Kommunikationscode (Wie andere optimal mit dir harmonieren)</span>
      </div>
      <span class="text-[10px] text-slate-400 font-tech">Beziehungs-Dynamik</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs pt-1">
      <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-200">
        <span class="font-bold block text-emerald-300 mb-0.5">✅ Optimaler Zugang:</span>
        <span id="personalityConnectText" class="font-lato">{p.socialInteractionCode.howToConnect}</span>
      </div>
      <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-200">
        <span class="font-bold block text-rose-300 mb-0.5">⚠️ Bitte vermeiden:</span>
        <span id="personalityAvoidText" class="font-lato">{p.socialInteractionCode.whatToAvoid}</span>
      </div>
    </div>
  </div>
</section>
