---
import type { CompleteNatalChart } from '../../lib/astrology/engine';
import { MAIN_ANGEL_NUMBERS, MIRROR_CLOCK_TIMES, REVERSED_CLOCK_TIMES, calculatePersonalAngelResonance } from '../../lib/numerology/angelNumbers';

interface Props {
  chart: CompleteNatalChart;
}

const { chart } = Astro.props;
const personalResonance = calculatePersonalAngelResonance(
  chart.numerology.lifePath.number,
  chart.synthesis.sun.planet.sign.name
);
---

<div class="space-y-10">
  <!-- Section Title -->
  <div class="text-center space-y-3 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full birkenbihl-badge text-yellow-300 text-xs font-semibold uppercase tracking-wider">
      <span>⏰</span> Kosmische Synchronizitäts-Matrix & Engelszahlen <span>🕊️</span>
    </div>
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-black text-white tracking-tight">
      Engelszahlen, Spiegeluhrzeiten & Seelen-Codes
    </h2>
    <p class="text-slate-300 text-sm leading-relaxed">
      Wenn dir wiederholt Zahlen wie 11:11, 222, 444 oder Spiegeluhrzeiten begegnen, ist das kein Zufall. Es sind quantenphysikalische Synchronizitäten, über die deine Geistführer direkt mit deinem Bewusstsein kommunizieren.
    </p>
  </div>

  <!-- Birkenbihl Neurodidactic Box on Synchronicities -->
  <div class="birkenbihl-box p-5 md:p-6 rounded-3xl space-y-3 shadow-xl">
    <div class="flex items-center gap-2.5">
      <span class="text-xl">🧠</span>
      <h3 class="text-sm font-extrabold uppercase tracking-widest text-amber-300">
        Birkenbihl-Konzept: Warum siehst du Engelszahlen & Uhrzeiten?
      </h3>
    </div>
    <p class="text-xs md:text-sm text-slate-200 leading-relaxed">
      Dein Gehirn besitzt einen Filter namens <strong class="text-white">RAS (Retikuläres Aktivierungssystem)</strong>. Wenn deine Seele innerlich reif für eine Erkenntnis oder Richtungsentscheidung ist, schaltet dein Unterbewusstsein diesen Filter frei. Du blickst <strong class="text-amber-300">exakt in der Sekunde</strong> auf die Uhr oder ein Nummernschild, wenn die Zahlenkombination mit deinem aktuellen Seelenzustand in Resonanz steht (C.G. Jungs Prinzip der <em>akusalen Synchronizität</em>).
    </p>
  </div>

  <!-- Personal Angel Resonance Hero Card -->
  <div class="cosmic-glass-gold rounded-3xl p-6 md:p-8 border border-amber-500/40 shadow-2xl relative overflow-hidden cosmic-corner-accent">
    <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left: Big Number Emblem (4 Cols) -->
      <div class="lg:col-span-4 flex flex-col items-center justify-center text-center p-6 rounded-2xl bg-black/50 border border-amber-500/40 shadow-inner">
        <div class="text-[10px] uppercase tracking-widest font-extrabold text-amber-400 mb-1">
          Deine Seelen-Haupt-Engelszahl
        </div>
        <div class="text-5xl md:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-b from-amber-200 via-yellow-400 to-amber-500 my-2 drop-shadow-[0_0_20px_rgba(234,179,8,0.4)] font-mono" id="angelMainNumber">
          {personalResonance.primaryAngelNumber.number.split(' ')[0]}
        </div>
        <div class="text-sm font-extrabold text-white" id="angelMainHeadline">
          {personalResonance.primaryAngelNumber.headline}
        </div>
        <div class="text-xs text-amber-300/80 mt-1" id="angelMainRuler">
          Herrscher: {personalResonance.primaryAngelNumber.rulingPlanet}
        </div>
        <div class="text-[11px] text-slate-400 mt-0.5" id="angelMainResonance">
          Resonanz: Lebenswegzahl {personalResonance.lifePathNumber}
        </div>
      </div>

      <!-- Right: Detailed Guidance (8 Cols) -->
      <div class="lg:col-span-8 space-y-4">
        <div>
          <h3 class="text-xl md:text-2xl font-extrabold text-white flex items-center gap-2">
            <span>Dein Kosmischer Weckruf</span>
            <span class="text-amber-400 text-xl" id="angelMainIcon">{personalResonance.primaryAngelNumber.icon}</span>
          </h3>
          <p class="text-sm text-slate-200 mt-1.5 leading-relaxed" id="angelMainGuidance">
            {personalResonance.guidance}
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-xs pt-1">
          <div class="p-3.5 rounded-2xl bg-pink-500/10 border border-pink-500/25 space-y-1">
            <div class="font-bold text-pink-300 flex items-center gap-1">
              <span>💖</span> Liebe & Dualseelen-Botschaft:
            </div>
            <p class="text-slate-300 text-[11px] leading-relaxed" id="angelLoveTwinFlame">
              {personalResonance.primaryAngelNumber.loveAndTwinFlame}
            </p>
          </div>

          <div class="p-3.5 rounded-2xl bg-cyan-500/10 border border-cyan-500/25 space-y-1">
            <div class="font-bold text-cyan-300 flex items-center gap-1">
              <span>⚡</span> Sofort-Aktion im Moment des Sehens:
            </div>
            <p class="text-slate-300 text-[11px] leading-relaxed" id="angelImmediateAction">
              {personalResonance.primaryAngelNumber.immediateAction}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- The 10 Major Master Angel Numbers Grid -->
  <div class="space-y-4">
    <div class="flex items-center gap-2.5 border-b border-white/10 pb-3">
      <span class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-base border border-amber-500/40">
        ✦
      </span>
      <div>
        <h3 class="text-xl font-bold text-white">Die 10 Großen Meister-Engelszahlen (000 bis 999 & 11:11 / 22:22)</h3>
        <p class="text-xs text-slate-400">Tiefenpsychologische, astrologische und praktische Bedeutung für alle Lebensbereiche</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {MAIN_ANGEL_NUMBERS.map(an => (
        <div class="cosmic-glass rounded-3xl p-6 border border-white/15 shadow-xl space-y-4 hover:border-amber-400/40 transition-all flex flex-col justify-between cosmic-corner-accent">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">{an.icon}</span>
                <div>
                  <span class="text-xl font-black text-white font-mono tracking-wider">{an.number}</span>
                </div>
              </div>
              <div class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300">
                {an.rulingPlanet} • {an.element}
              </div>
            </div>

            <h4 class="text-base font-extrabold text-amber-300">
              {an.headline}
            </h4>

            <p class="text-xs md:text-sm text-slate-200 leading-relaxed">
              {an.coreSpiritualMeaning}
            </p>

            <!-- 3 Life Domains Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs">
              <div class="p-3 rounded-xl bg-pink-950/20 border border-pink-500/20 space-y-1">
                <div class="font-bold text-pink-300 text-[11px] flex items-center gap-1">
                  <span>💖</span> Liebe & Seelenpartner:
                </div>
                <div class="text-slate-300 text-[11px] leading-snug">{an.loveAndTwinFlame}</div>
              </div>

              <div class="p-3 rounded-xl bg-amber-950/20 border border-amber-500/20 space-y-1">
                <div class="font-bold text-amber-300 text-[11px] flex items-center gap-1">
                  <span>💼</span> Beruf & Fülle:
                </div>
                <div class="text-slate-300 text-[11px] leading-snug">{an.careerAndAbundance}</div>
              </div>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-slate-950/80 border border-amber-500/30 text-xs space-y-1">
            <div class="font-bold text-amber-300 flex items-center gap-1">
              <span>⚡</span> Sofort-Handlungsimpuls beim Sehen:
            </div>
            <div class="text-slate-300 italic text-[11px]">{an.immediateAction}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- The Complete 24 Mirror Clock Times Matrix -->
  <div class="cosmic-glass rounded-3xl p-6 md:p-8 border border-white/10 space-y-6 shadow-2xl">
    <div class="flex items-center gap-3 border-b border-white/10 pb-4">
      <span class="w-9 h-9 rounded-xl bg-cyan-500/20 text-cyan-300 flex items-center justify-center font-bold text-lg border border-cyan-500/30">
        ⏰
      </span>
      <div>
        <h3 class="text-xl font-bold text-white">Die 24 Doppeluhrzeiten & Spiegeluhrzeiten (01:01 bis 00:00)</h3>
        <p class="text-xs text-slate-400">Blickst du genau zu diesen Uhrzeiten aufs Smartphone oder die Wanduhr? Das will dir das Universum sagen:</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
      {MIRROR_CLOCK_TIMES.map(mt => (
        <div class="p-3.5 rounded-2xl bg-slate-950/70 border border-white/10 hover:border-cyan-400/40 transition-all space-y-1.5 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-base font-black font-mono text-cyan-300 bg-cyan-500/10 px-2 py-0.5 rounded border border-cyan-500/30">
              {mt.time}
            </span>
            <span class="text-lg">{mt.icon}</span>
          </div>
          <p class="text-[11px] text-slate-200 leading-snug">
            {mt.meaning}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Reversed Mirror Times Matrix -->
  <div class="cosmic-glass rounded-3xl p-6 md:p-8 border border-white/10 space-y-6 shadow-2xl">
    <div class="flex items-center gap-3 border-b border-white/10 pb-4">
      <span class="w-9 h-9 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center font-bold text-lg border border-purple-500/30">
        🔄
      </span>
      <div>
        <h3 class="text-xl font-bold text-white">Umgekehrte Spiegeluhrzeiten (Reversed Times)</h3>
        <p class="text-xs text-slate-400">Botschaften aus dem Spiegelkabinett der Seele (12:21, 13:31, 14:41, 15:51, 20:02, 21:12, 23:32)</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
      {REVERSED_CLOCK_TIMES.map(rt => (
        <div class="p-3.5 rounded-2xl bg-slate-950/70 border border-purple-500/20 hover:border-purple-400/40 transition-all space-y-1.5 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-base font-black font-mono text-purple-300 bg-purple-500/10 px-2 py-0.5 rounded border border-purple-500/30">
              {rt.time}
            </span>
            <span class="text-lg">{rt.icon}</span>
          </div>
          <p class="text-[11px] text-slate-200 leading-snug">
            {rt.meaning}
          </p>
        </div>
      ))}
    </div>
  </div>

</div>
