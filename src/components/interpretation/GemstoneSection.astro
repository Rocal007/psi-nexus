---
import type { CompleteNatalChart } from '../../lib/astrology/engine';
import { generatePersonalGemstones } from '../../lib/astrology/gemstones';

interface Props {
  chart: CompleteNatalChart;
}

const { chart } = Astro.props;
const gemstones = generatePersonalGemstones(chart);
---

<div class="space-y-10">
  <!-- Section Title -->
  <div class="text-center space-y-3 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full birkenbihl-badge text-emerald-300 text-xs font-semibold uppercase tracking-wider">
      <span>💎</span> Tor VI: Kosmische Kristall-Resonanz & Heilsteine <span>💎</span>
    </div>
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-black text-white tracking-tight">
      Deine Persönliche Seelen-Kristall-Apotheke
    </h2>
    <p class="text-slate-300 text-sm leading-relaxed">
      Heilsteine sind geometrisch hochgeordnete Mineralgitter, deren Schwingungsfrequenz direkt mit deinen Gestirnen, Chakren und seelischen Grundbedürfnissen in Resonanz tritt.
    </p>
  </div>

  <!-- Birkenbihl Neurodidaktik Box for Crystals -->
  <div class="birkenbihl-box p-5 md:p-6 rounded-3xl space-y-3 shadow-xl">
    <div class="flex items-center gap-2.5">
      <span class="text-xl">💡</span>
      <h3 class="text-sm font-extrabold uppercase tracking-widest text-amber-300">
        Birkenbihl-Versteher-Schlüssel: Wie & Warum Heilsteine wirken
      </h3>
    </div>
    <p class="text-xs md:text-sm text-slate-200 leading-relaxed">
      Jeder echte Kristall besitzt eine <strong class="text-white">stabile piezoelektrische und atomare Eigenschwingung</strong>. Wenn du gestresst, erschöpft oder emotional aus der Mitte bist, gerät dein körpereigenes Biofeld in Unruhe. Ein resonanter Heilstein dient deinem Nervensystem und deinen Chakren als <strong class="text-amber-300">stabile Stimmgabel</strong>, um mühelos in deine natürliche seelische Harmonie zurückzufinden.
    </p>
  </div>

  <!-- Primary Personal 6 Crystals Grid -->
  <div class="space-y-4">
    <div class="flex items-center gap-2.5 border-b border-white/10 pb-3">
      <span class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold text-base border border-amber-500/40">
        ✦
      </span>
      <div>
        <h3 class="text-xl font-bold text-white">Deine 6 Persönlichen Seelen-Heilsteine</h3>
        <p class="text-xs text-slate-400">Exakt berechnet aus deiner Sonne, deinem Mond, Aszendenten, Chiron, Elementen und Schicksalsknoten</p>
      </div>
    </div>

    <div id="personalGemstonesContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- 1. Sun Stone -->
      <div class="cosmic-glass-gold rounded-3xl p-6 border border-amber-500/40 flex flex-col justify-between space-y-5 shadow-2xl relative overflow-hidden cosmic-corner-accent">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-widest font-extrabold text-amber-400">1. Kern-Vitalität (☉ Sonne)</span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border text-amber-300 bg-amber-500/20 border-amber-500/40">
              {gemstones.sunStone.chakra}
            </span>
          </div>

          <div>
            <div class="flex items-center gap-2">
              <span class="text-2xl">{gemstones.sunStone.iconEmoji}</span>
              <h4 class="text-lg font-black text-white">{gemstones.sunStone.name}</h4>
            </div>
            <div class="text-xs text-amber-300/80 font-medium mt-0.5">{gemstones.sunStone.role}</div>
            <div class="text-[11px] text-slate-400 font-mono mt-0.5">Mineral: {gemstones.sunStone.mineralFamily}</div>
          </div>

          <!-- Need -->
          <div class="p-3 rounded-2xl bg-amber-500/10 border border-amber-500/25 space-y-1">
            <div class="text-xs font-bold text-amber-300 flex items-center gap-1">
              <span>🎯</span> Seelisches Bedürfnis:
            </div>
            <p class="text-xs text-slate-200 leading-relaxed">{gemstones.sunStone.primaryNeed}</p>
          </div>

          <!-- Why & Reason -->
          <div class="space-y-1.5 text-xs text-slate-300">
            <div class="font-bold text-white flex items-center gap-1">
              <span>🔍</span> Warum & Wieso (Kosmische Resonanz):
            </div>
            <p class="leading-relaxed text-slate-300">{gemstones.sunStone.whyAndReason}</p>
          </div>

          <!-- Effects -->
          <div class="space-y-1 text-xs">
            <div class="font-bold text-amber-300">✨ Was er konkret unterstützt:</div>
            <ul class="space-y-1 text-slate-300 text-[11px]">
              {gemstones.sunStone.supportEffects.map(eff => (
