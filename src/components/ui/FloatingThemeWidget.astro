---
// Floating Theme Switcher Quick-Access Widget
import ThemeSwitcher from './ThemeSwitcher.astro';
---

<div class="fixed bottom-5 right-5 z-50 no-print flex flex-col items-end gap-2" id="floatingThemeWidget">
  <!-- Expandable Theme Switcher Bar -->
  <div
    id="floatingThemeMenu"
    class="opacity-95 hover:opacity-100 transition-all duration-300 transform scale-95 hover:scale-100 shadow-2xl rounded-2xl"
  >
    <ThemeSwitcher variant="floating" />
  </div>
</div>
