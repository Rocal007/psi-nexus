---
import type { ChartInput } from '../../lib/astrology/engine';
import ActiveProfileSummaryCard from './birthform/ActiveProfileSummaryCard.astro';
import BirthFormManualInputs from './birthform/BirthFormManualInputs.astro';
import BirthFormSavedProfilesTab from './birthform/BirthFormSavedProfilesTab.astro';

interface Props {
  initialValues?: Partial<ChartInput>;
  hasActiveProfile?: boolean;
}

const { initialValues, hasActiveProfile = false } = Astro.props;

const defaultDate = initialValues?.birthDate || '';
const defaultTime = initialValues?.birthTime || '12:00';
const defaultCity = initialValues?.cityName || '';
const defaultLat = initialValues?.latitude ?? 48.2082;
const defaultLng = initialValues?.longitude ?? 16.3738;
const defaultTz = initialValues?.timezone || 'Europe/Vienna';
const defaultSystem = initialValues?.houseSystem || 'placidus';
const defaultName = initialValues?.name || '';
---

<!-- 1. Active Profile Summary Bar -->
<ActiveProfileSummaryCard
  hasActiveProfile={hasActiveProfile}
  defaultName={defaultName}
  defaultDate={defaultDate}
  defaultTime={defaultTime}
  defaultCity={defaultCity}
  defaultSystem={defaultSystem}
/>

<!-- 2. Collapsible Form Container -->
<div
  id="formContainer"
  class={`cosmic-glass-gold rounded-3xl p-6 md:p-8 border border-amber-500/35 shadow-2xl relative cosmic-corner-accent transition-all duration-300 ${hasActiveProfile ? 'hidden' : ''} mt-4`}
>
  <!-- Header Banner -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-5 border-b border-white/10 pb-4">
    <div class="flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-500/30 to-purple-500/20 text-amber-300 flex items-center justify-center font-bold text-2xl border border-amber-500/40 shadow-[0_0_20px_rgba(234,179,8,0.2)]">
        ✦
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] uppercase font-bold tracking-widest text-amber-400 font-tech">Schritt 1: Profil-Wahl</span>
          <span class="text-[10px] text-slate-400">• SQLite & Ephemeriden</span>
        </div>
        <h2 class="text-xl md:text-2xl font-extrabold text-white">
          Wähle oder erstelle dein Seelen-Profil
        </h2>
        <p class="text-xs text-slate-300">Entweder eigene Geburtsdaten eingeben ODER ein gespeichertes Profil / einen Meister-Archetypen auswählen.</p>
      </div>
    </div>

    <!-- Close / Collapse Button -->
    <button
      type="button"
      id="closeFormBtn"
      class={`px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs text-slate-300 hover:text-white flex items-center gap-1 cursor-pointer ${hasActiveProfile ? '' : 'hidden'}`}
    >
      <span>✕</span>
      <span>Schließen</span>
    </button>
  </div>

  <!-- Segmented Mode Switcher -->
  <div class="flex items-center gap-2 p-1.5 rounded-2xl bg-slate-950/80 border border-white/10 mb-6 max-w-xl mx-auto">
    <button
      type="button"
      id="tabModeEnter"
      class="mode-toggle-btn flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-sm cursor-pointer"
    >
      <span>✏️</span>
      <span>1. Profil selbst eingeben</span>
    </button>
    <button
      type="button"
      id="tabModeSelect"
      class="mode-toggle-btn flex-1 py-2.5 px-4 rounded-xl text-xs font-semibold text-slate-400 hover:text-white transition-all flex items-center justify-center gap-2 border border-transparent hover:bg-white/5 cursor-pointer"
    >
      <span>👥</span>
      <span>2. Profil auswählen (Gespeichert & Demo)</span>
    </button>
  </div>

  <!-- Panel 1: Manual Form Inputs -->
  <BirthFormManualInputs
    defaultDate={defaultDate}
    defaultTime={defaultTime}
    defaultCity={defaultCity}
    defaultLat={defaultLat}
    defaultLng={defaultLng}
    defaultTz={defaultTz}
    defaultSystem={defaultSystem}
    defaultName={defaultName}
  />

  <!-- Panel 2: Saved Profiles & Presets -->
  <BirthFormSavedProfilesTab />
</div>

<script>
  import { initBirthFormController } from '../../scripts/controllers/birthFormController';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBirthFormController);
  } else {
    initBirthFormController();
  }
</script>
