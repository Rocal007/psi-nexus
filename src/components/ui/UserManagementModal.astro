---
// UserManagementModal.astro - Modular User Management Dashboard (Industrial Gold Standard)
import UserManagementAuthSection from './usermanagement/UserManagementAuthSection.astro';
import UserManagementStatsBar from './usermanagement/UserManagementStatsBar.astro';
import UserManagementFormSection from './usermanagement/UserManagementFormSection.astro';
import UserManagementFilterBar from './usermanagement/UserManagementFilterBar.astro';
import UserManagementTableContainer from './usermanagement/UserManagementTableContainer.astro';
---

<div
  id="userManagementModal"
  class="fixed inset-0 z-[60] bg-slate-950/90 backdrop-blur-2xl transition-all duration-300 opacity-0 pointer-events-none flex items-center justify-center p-3 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="userModalTitle"
>
  <!-- Backdrop Click Listener -->
  <div id="userModalBackdrop" class="fixed inset-0 cursor-pointer"></div>

  <!-- Modal Container -->
  <div
    id="userModalContainer"
    class="relative w-full max-w-5xl bg-slate-950 border border-white/15 rounded-3xl p-4 sm:p-7 shadow-[0_0_50px_rgba(0,0,0,0.8)] z-10 space-y-6 max-h-[92vh] flex flex-col transform scale-95 transition-transform duration-300 overflow-hidden"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-white/10 pb-4 shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-500 to-purple-600 p-[1.5px] shadow-[0_0_20px_rgba(234,179,8,0.25)] shrink-0">
          <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center text-amber-300 text-xl font-bold">
            👥
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 id="userModalTitle" class="text-lg sm:text-xl font-black text-white tracking-wide">
              Benutzer- & Seelenverwaltung
            </h2>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              SQLite Backend
            </span>
          </div>
          <p class="text-xs text-slate-400 hidden sm:block">
            Zentrale Verwaltung aller Klienten-, Partner- und Familien-Profile mit Login und Zwei-Wege-Synchronisation.
          </p>
        </div>
      </div>

      <!-- Header Action Buttons -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btnToggleLoginSection"
          class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-amber-500/20 via-amber-500/30 to-amber-600/20 hover:from-amber-500/35 hover:to-amber-600/35 border border-amber-500/40 text-amber-300 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm"
          title="Als Benutzer anmelden oder Profil wechseln"
        >
          <span id="loginBtnIcon">🔑</span>
          <span id="loginBtnText">Einloggen</span>
        </button>

        <button
          type="button"
          id="btnModalSyncBackend"
          class="px-3 py-1.5 rounded-xl bg-purple-500/15 hover:bg-purple-500/25 border border-purple-500/30 text-purple-300 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm"
          title="Jetzt mit der lokalen SQLite-Datenbank synchronisieren"
        >
          <span id="syncSpinner" class="inline-block transition-transform duration-500">🔄</span>
          <span class="hidden sm:inline">Server-Sync</span>
        </button>

        <button
          type="button"
          id="btnToggleAddUserForm"
          class="px-3 py-1.5 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/30 text-amber-300 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm"
        >
          <span>✧</span>
          <span class="hidden sm:inline">Neuer Benutzer</span>
        </button>

        <button
          type="button"
          id="btnCloseUserModal"
          class="w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white flex items-center justify-center text-sm transition-all cursor-pointer"
          aria-label="Schließen"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Subcomponents -->
    <UserManagementAuthSection />
    <UserManagementStatsBar />
    <UserManagementFormSection />
    <UserManagementFilterBar />
    <UserManagementTableContainer />

    <!-- Modal Footer Status -->
    <div class="flex items-center justify-between text-[11px] text-slate-400 border-t border-white/10 pt-3 shrink-0">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span id="syncStatusText">Synchronisiert mit SQLite Backend</span>
      </div>
      <div class="font-mono text-[10px] text-slate-500">
        Ψ-NEXUS v2.0 • Data Sovereignty & Auth Engine
      </div>
    </div>
  </div>
</div>

<script>
  import { initUserManagementController } from '../../scripts/controllers/userManagementController';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUserManagementController);
  } else {
    initUserManagementController();
  }
</script>
