---
// Soul Wizard Navigator Component (Schritt-für-Schritt Seelen-Wizard)
// Transforms overwhelming astrological content into a guided, bite-sized step-by-step experience (Birkenbihl VFB: Pauken -> 0).

export interface WizardStep {
  id: string;
  stepNum: number;
  gateTitle: string;
  shortEssence: string;
  icon: string;
  sphere: string;
}

const WIZARD_STEPS: WizardStep[] = [
  { id: 'radix', stepNum: 1, gateTitle: 'Kosmisches Fundament', shortEssence: 'Dein Himmels-Bauplan, Sonnen-Kraft & 4 Lebensachsen', icon: '🌌', sphere: 'Wesen' },
  { id: 'pillars', stepNum: 2, gateTitle: 'Die 3 Lebens-Säulen', shortEssence: 'Deine seelische Verwirklichung in Liebe, Beruf & Alltag', icon: '💖', sphere: 'Wesen' },
  { id: 'dossier', stepNum: 3, gateTitle: 'Hohes Seelen-Dossier', shortEssence: 'Die 7 Kosmischen Strahlen & Deine Ur-Seelenalchemie', icon: '✦', sphere: 'Wesen' },
  { id: 'karmic', stepNum: 4, gateTitle: 'Karmische Tore', shortEssence: 'Mondknoten-Achse, Seelenwunden & dein größtes Schicksalswachstum', icon: '☊', sphere: 'Karma' },
  { id: 'numerology', stepNum: 5, gateTitle: 'Pythagoras Numerologie', shortEssence: 'Dein mathematischer Schwingungscode aus Name & Geburtsdatum', icon: '🔢', sphere: 'Karma' },
  { id: 'angel_numbers', stepNum: 6, gateTitle: 'Engelszahlen & Uhren', shortEssence: 'Kosmische Spiegeluhrzeiten (11:11, 222) & Botschaften', icon: '🕊️', sphere: 'Karma' },
  { id: 'gemstones', stepNum: 7, gateTitle: 'Heilstein-Apotheke', shortEssence: 'Bio-energetische Kristalle & psychosomatische Organbalance', icon: '💎', sphere: 'Praxis' },
  { id: 'moon_wisdom', stepNum: 8, gateTitle: 'Mond & Lebensführer', shortEssence: 'Mondkalender für Haare, Haushalt & dein ewiger Seelen-Leitspruch', icon: '🌙', sphere: 'Praxis' },
  { id: 'constellations', stepNum: 9, gateTitle: 'Sternbilder-Atlas', shortEssence: 'Die 12 Tierkreiszeichen & mythologischer Sternenhimmel', icon: '✨', sphere: 'Praxis' },
  { id: 'geochart', stepNum: 10, gateTitle: 'Astro-Kartographie', shortEssence: 'Weltkarte deiner stärksten persönlichen Kraft- & Erfolgsorte', icon: '🌍', sphere: 'Orte' },
  { id: 'synastry', stepNum: 11, gateTitle: 'Partner & Familie', shortEssence: 'Karmische Seelenverwandtschaften & Beziehungsdynamiken', icon: '💞', sphere: 'Orte' },
  { id: 'humandesign', stepNum: 12, gateTitle: 'Human Design Matrix', shortEssence: 'Dein genetisches Betriebssystem: Bodygraph, 9 Zentren & PHS', icon: '🧬', sphere: 'Design' }
];

interface Props {
  activeGate?: string;
}

const { activeGate = 'radix' } = Astro.props;
---

<div id="soulWizardNavigator" class="w-full no-print space-y-3">
  <!-- Top Wizard Bar in Boxed Style -->
  <div class="p-4 sm:p-5 rounded-2xl bg-slate-900/90 border border-white/10 shadow-2xl backdrop-blur-xl relative overflow-hidden">
    <!-- Subtle top gold highlight line -->
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-amber-400/50 to-transparent"></div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      
      <!-- Left: Wizard Step Info & Icon -->
      <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-2xl bg-amber-500/15 border border-amber-500/35 flex items-center justify-center text-2xl shadow-inner shrink-0" id="wizardActiveIcon">
          🌌
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded-md bg-amber-500/15 text-amber-300 border border-amber-500/30 text-[10px] font-mono font-bold uppercase tracking-wider" id="wizardStepCounter">
              Schritt 1 von 12
            </span>
            <span class="text-xs text-slate-400 font-tech uppercase tracking-widest hidden sm:inline" id="wizardSphereLabel">
              • Sphäre: Wesen
            </span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-white tracking-wide mt-0.5" id="wizardStepHeading">
            Tor I: Kosmisches Fundament
          </h3>
          <p class="text-xs text-slate-300 hidden sm:block max-w-xl truncate mt-0.5" id="wizardStepDescription">
            Dein Himmels-Bauplan, Sonnen-Kraft & 4 Lebensachsen
          </p>
        </div>
      </div>

      <!-- Right: Step Navigation Controls (Vor / Zurück / Übersicht) -->
      <div class="flex items-center gap-2 self-end md:self-center shrink-0">
        <button
          type="button"
          id="wizardPrevBtn"
          class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-amber-400/30 text-xs font-semibold text-slate-300 hover:text-white flex items-center gap-1.5 transition-all cursor-pointer disabled:opacity-30 disabled:pointer-events-none"
          title="Vorheriger Schritt (Tastatur: Pfeiltaste Links)"
        >
          <span>←</span>
          <span class="hidden sm:inline">Zurück</span>
        </button>

        <button
          type="button"
          id="wizardNextBtn"
          class="px-5 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-xs font-bold text-amber-300 flex items-center gap-2 hover:scale-[1.02] transition-all cursor-pointer shadow-md"
          title="Nächster Schritt (Tastatur: Pfeiltaste Rechts)"
        >
          <span>Nächster Schritt</span>
          <span class="text-sm">➔</span>
        </button>
      </div>

    </div>

    <!-- Live Animated Progress Bar -->
    <div class="mt-4 pt-3 border-t border-white/5 space-y-1.5">
      <div class="flex items-center justify-between text-[10px] font-mono text-slate-400">
        <span>Seelenbuch-Fortschritt</span>
        <span class="text-amber-300 font-bold" id="wizardProgressPercentage">8% abgeschlossen</span>
      </div>
      <div class="w-full h-1.5 rounded-full bg-slate-950/80 border border-white/10 overflow-hidden relative">
        <div
          id="wizardProgressBar"
          class="h-full bg-gradient-to-r from-amber-500 to-yellow-400 rounded-full transition-all duration-500"
          style="width: 8.33%;"
        ></div>
      </div>
    </div>

    <!-- Wizard Mini Stepper Dots for Fast-Click -->
    <div class="flex items-center justify-between gap-1 pt-3 overflow-x-auto scrollbar-none" id="wizardQuickPills">
      {WIZARD_STEPS.map((step, idx) => (
        <button
          type="button"
          class={`wizard-pill-btn flex-1 min-w-[28px] py-1.5 rounded-lg border text-center transition-all cursor-pointer ${idx === 0 ? 'bg-amber-500/20 border-amber-400/70 text-amber-300 font-bold ring-1 ring-amber-400/30' : 'bg-white/[0.03] border-white/5 text-slate-400 hover:text-white hover:bg-white/10'}`}
          data-wizard-target={step.id}
          data-step-index={idx}
          title={`Schritt ${step.stepNum}: ${step.gateTitle}`}
        >
          <span class="text-[10px] font-mono">{step.stepNum}</span>
        </button>
      ))}
    </div>

  </div>
</div>

<script>
  const WIZARD_DATA = [
    { id: 'radix', stepNum: 1, gateTitle: 'Tor I: Kosmisches Fundament', shortEssence: 'Dein Himmels-Bauplan, Sonnen-Kraft & 4 Lebensachsen', icon: '🌌', sphere: 'Wesen' },
    { id: 'pillars', stepNum: 2, gateTitle: 'Tor II: Die 3 Lebens-Säulen', shortEssence: 'Deine seelische Verwirklichung in Liebe, Beruf & Alltag', icon: '💖', sphere: 'Wesen' },
    { id: 'dossier', stepNum: 3, gateTitle: 'Tor III: Hohes Seelen-Dossier', shortEssence: 'Die 7 Kosmischen Strahlen & Deine Ur-Seelenalchemie', icon: '✦', sphere: 'Wesen' },
    { id: 'karmic', stepNum: 4, gateTitle: 'Tor IV: Karmische Tore', shortEssence: 'Mondknoten-Achse, Seelenwunden & dein größtes Schicksalswachstum', icon: '☊', sphere: 'Karma' },
    { id: 'numerology', stepNum: 5, gateTitle: 'Tor V: Pythagoras Numerologie', shortEssence: 'Dein mathematischer Schwingungscode aus Name & Geburtsdatum', icon: '🔢', sphere: 'Karma' },
    { id: 'angel_numbers', stepNum: 6, gateTitle: 'Tor VI: Engelszahlen & Uhren', shortEssence: 'Kosmische Spiegeluhrzeiten (11:11, 222) & Synchronizitäten', icon: '🕊️', sphere: 'Karma' },
    { id: 'gemstones', stepNum: 7, gateTitle: 'Tor VII: Heilstein-Apotheke', shortEssence: 'Bio-energetische Kristalle & psychosomatische Organbalance', icon: '💎', sphere: 'Praxis' },
    { id: 'moon_wisdom', stepNum: 8, gateTitle: 'Tor VIII: Mond & Lebensführer', shortEssence: 'Mondkalender für Haare, Haushalt & dein ewiger Seelen-Leitspruch', icon: '🌙', sphere: 'Praxis' },
    { id: 'constellations', stepNum: 9, gateTitle: 'Tor IX: Sternbilder-Atlas', shortEssence: 'Die 12 Tierkreiszeichen & mythologischer Sternenhimmel', icon: '✨', sphere: 'Praxis' },
    { id: 'geochart', stepNum: 10, gateTitle: 'Tor X: Astro-Kartographie', shortEssence: 'Weltkarte deiner stärksten persönlichen Kraft- & Erfolgsorte', icon: '🌍', sphere: 'Orte' },
    { id: 'synastry', stepNum: 11, gateTitle: 'Tor XI: Partner & Familie', shortEssence: 'Karmische Seelenverwandtschaften & Beziehungsdynamiken', icon: '💞', sphere: 'Orte' },
    { id: 'humandesign', stepNum: 12, gateTitle: 'Tor XII: Human Design Matrix', shortEssence: 'Dein genetisches Betriebssystem: Bodygraph, 9 Zentren & PHS', icon: '🧬', sphere: 'Design' }
  ];

  let currentStepIndex = 0;

  function updateWizardUI(stepIndex: number) {
    if (stepIndex < 0 || stepIndex >= WIZARD_DATA.length) return;
    currentStepIndex = stepIndex;
    const step = WIZARD_DATA[stepIndex];

    const iconEl = document.getElementById('wizardActiveIcon');
    const counterEl = document.getElementById('wizardStepCounter');
    const headingEl = document.getElementById('wizardStepHeading');
    const descEl = document.getElementById('wizardStepDescription');
    const sphereEl = document.getElementById('wizardSphereLabel');
    const progressPercentageEl = document.getElementById('wizardProgressPercentage');
    const progressBarEl = document.getElementById('wizardProgressBar');
    const prevBtn = document.getElementById('wizardPrevBtn') as HTMLButtonElement;
    const nextBtn = document.getElementById('wizardNextBtn') as HTMLButtonElement;
    const pillButtons = document.querySelectorAll('.wizard-pill-btn');

    if (iconEl) iconEl.textContent = step.icon;
    if (counterEl) counterEl.textContent = `Schritt ${step.stepNum} von 12`;
    if (headingEl) headingEl.textContent = step.gateTitle;
    if (descEl) descEl.textContent = step.shortEssence;
    if (sphereEl) sphereEl.textContent = `• Sphäre: ${step.sphere}`;

    const percent = Math.round(((stepIndex + 1) / WIZARD_DATA.length) * 100);
    if (progressPercentageEl) progressPercentageEl.textContent = `${percent}% abgeschlossen`;
    if (progressBarEl) progressBarEl.style.width = `${percent}%`;

    if (prevBtn) prevBtn.disabled = stepIndex === 0;
    if (nextBtn) {
      if (stepIndex === WIZARD_DATA.length - 1) {
        nextBtn.innerHTML = `<span>Abschluss (Zurück zu Tor I)</span> ↺`;
      } else {
        nextBtn.innerHTML = `<span>Nächster Schritt</span> ➔`;
      }
    }

    pillButtons.forEach((btn, idx) => {
      if (idx === stepIndex) {
        btn.className = 'wizard-pill-btn flex-1 min-w-[28px] py-1.5 rounded-lg border text-center transition-all cursor-pointer bg-amber-500/20 border-amber-400/70 text-amber-300 font-bold ring-1 ring-amber-400/30';
      } else {
        btn.className = 'wizard-pill-btn flex-1 min-w-[28px] py-1.5 rounded-lg border text-center transition-all cursor-pointer bg-white/[0.03] border-white/5 text-slate-400 hover:text-white hover:bg-white/10';
      }
    });
  }

  function setupWizardNavigation() {
    const prevBtn = document.getElementById('wizardPrevBtn');
    const nextBtn = document.getElementById('wizardNextBtn');
    const pillButtons = document.querySelectorAll('.wizard-pill-btn');

    function navigateToStep(index: number) {
      if (index < 0) index = 0;
      if (index >= WIZARD_DATA.length) index = 0;
      const targetStep = WIZARD_DATA[index];
      
      // Trigger the main tab click
      const matchingTab = document.querySelector(`.tab-btn[data-tab-target="${targetStep.id}"]`) as HTMLElement;
      if (matchingTab) {
        matchingTab.click();
      }
      updateWizardUI(index);
    }

    prevBtn?.addEventListener('click', () => {
      navigateToStep(currentStepIndex - 1);
    });

    nextBtn?.addEventListener('click', () => {
      navigateToStep(currentStepIndex + 1);
    });

    pillButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const stepIdx = parseInt(btn.getAttribute('data-step-index') || '0', 10);
        navigateToStep(stepIdx);
      });
    });

    // Keyboard support: ArrowLeft and ArrowRight for effortless wizard walkthrough
    document.addEventListener('keydown', (e) => {
      // Don't trigger if user is typing inside an input/textarea
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select') return;

      if (e.key === 'ArrowRight') {
        navigateToStep(currentStepIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        navigateToStep(currentStepIndex - 1);
      }
    });

    // Sync wizard with tab changes from any other trigger
    const allTabButtons = document.querySelectorAll('.tab-btn, .tab-nav-btn, .hero-identity-pill, .drawer-gate-btn');
    allTabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab-target') || btn.getAttribute('data-switch-to') || btn.getAttribute('data-pill-gate') || btn.getAttribute('data-gate-target');
        const foundIdx = WIZARD_DATA.findIndex(w => w.id === targetId);
        if (foundIdx !== -1) {
          updateWizardUI(foundIdx);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWizardNavigation);
  } else {
    setupWizardNavigation();
  }
</script>
