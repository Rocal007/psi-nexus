---
// BirthFormSavedProfilesTab: Tab 2 for selecting saved profiles or demo archetypes
---

<!-- PANEL B: Select Existing Profile or Demo Archetype -->
<div id="panelModeSelect" class="space-y-6 hidden">
  
  <!-- Section 1: Gespeicherte Profile aus der DB -->
  <div class="space-y-3">
    <div class="flex items-center justify-between border-b border-white/10 pb-2">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-300 font-tech">
        <span>👥</span>
        <span>Deine gespeicherten Seelen-Profile (<span id="selectPanelProfileCount">0</span>)</span>
      </div>
      <span class="text-[10px] text-slate-400 font-mono">SQLite / LocalStorage</span>
    </div>

    <div id="selectPanelProfilesList" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
      <!-- Dynamically populated with saved profile cards -->
    </div>

    <div id="selectPanelNoProfilesHint" class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 text-center text-xs text-slate-400 space-y-1">
      <p>Noch keine eigenen Profile gespeichert.</p>
      <p class="text-[11px] text-slate-500">Klicke oben auf „1. Profil selbst eingeben“ oder wähle unten einen Meister-Archetypen.</p>
    </div>
  </div>

  <!-- Section 2: 6 Inspirierende Meister & Demo-Archetypen -->
  <div class="space-y-3 pt-2">
    <div class="flex items-center justify-between border-b border-white/10 pb-2">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-300 font-tech">
        <span>🌌</span>
        <span>Inspirierende Meister & Archetypen (1452 – Gegenwart)</span>
      </div>
      <span class="text-[10px] text-slate-400 font-mono">1-Klick Vorschau</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <!-- 1. Leonardo da Vinci -->
      <button
        type="button"
        class="preset-btn p-4 rounded-2xl bg-slate-950/80 hover:bg-slate-900 border border-white/10 hover:border-amber-500/50 transition-all text-left space-y-1.5 group cursor-pointer shadow-md"
        data-date="1452-04-15"
        data-time="21:40"
        data-city="Vinci"
        data-lat="43.7844"
        data-lng="10.9258"
        data-tz="Europe/Rome"
        data-name="Leonardo da Vinci"
      >
        <div class="flex items-center justify-between">
          <span class="text-xl">🎨</span>
          <span class="text-[10px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">1452</span>
        </div>
        <div class="font-bold text-white group-hover:text-amber-300 text-sm transition-colors">Leonardo da Vinci</div>
        <p class="text-[11px] text-slate-400 leading-snug">Universalgenie & Renaissance-Meister • Widder ☉ / Schütze ↑</p>
        <div class="text-[10px] font-bold text-amber-300/80 pt-1 group-hover:text-amber-300">Profil laden & Fragen stellen ➔</div>
      </button>

      <!-- 2. J. W. von Goethe -->
      <button
        type="button"
        class="preset-btn p-4 rounded-2xl bg-slate-950/80 hover:bg-slate-900 border border-white/10 hover:border-amber-500/50 transition-all text-left space-y-1.5 group cursor-pointer shadow-md"
        data-date="1749-08-28"
        data-time="12:00"
        data-city="Frankfurt am Main"
        data-lat="50.1109"
        data-lng="8.6821"
        data-tz="Europe/Berlin"
        data-name="J. W. von Goethe"
      >
        <div class="flex items-center justify-between">
          <span class="text-xl">🖋️</span>
          <span class="text-[10px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">1749</span>
        </div>
        <div class="font-bold text-white group-hover:text-amber-300 text-sm transition-colors">J.W. von Goethe</div>
        <p class="text-[11px] text-slate-400 leading-snug">Dichterfürst & Universalgelehrter • Jungfrau ☉ / Skorpion ↑</p>
        <div class="text-[10px] font-bold text-amber-300/80 pt-1 group-hover:text-amber-300">Profil laden & Fragen stellen ➔</div>
      </button>

      <!-- 3. C. G. Jung -->
      <button
        type="button"
        class="preset-btn p-4 rounded-2xl bg-slate-950/80 hover:bg-slate-900 border border-white/10 hover:border-amber-500/50 transition-all text-left space-y-1.5 group cursor-pointer shadow-md"
        data-date="1875-07-26"
        data-time="19:30"
        data-city="Kesswil"
        data-lat="47.5976"
        data-lng="9.3175"
        data-tz="Europe/Zurich"
        data-name="Carl Gustav Jung"
      >
        <div class="flex items-center justify-between">
          <span class="text-xl">🧠</span>
          <span class="text-[10px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">1875</span>
        </div>
        <div class="font-bold text-white group-hover:text-amber-300 text-sm transition-colors">Carl Gustav Jung</div>
        <p class="text-[11px] text-slate-400 leading-snug">Begründer der Archetypen-Lehre • Löwe ☉ / Wassermann ↑</p>
        <div class="text-[10px] font-bold text-amber-300/80 pt-1 group-hover:text-amber-300">Profil laden & Fragen stellen ➔</div>
      </button>

      <!-- 4. Albert Einstein -->
      <button
        type="button"
        class="preset-btn p-4 rounded-2xl bg-slate-950/80 hover:bg-slate-900 border border-white/10 hover:border-amber-500/50 transition-all text-left space-y-1.5 group cursor-pointer shadow-md"
        data-date="1879-03-14"
        data-time="11:30"
        data-city="Ulm"
        data-lat="48.4011"
        data-lng="9.9876"
        data-tz="Europe/Berlin"
        data-name="Albert Einstein"
      >
        <div class="flex items-center justify-between">
          <span class="text-xl">🌌</span>
          <span class="text-[10px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">1879</span>
        </div>
        <div class="font-bold text-white group-hover:text-amber-300 text-sm transition-colors">Albert Einstein</div>
        <p class="text-[11px] text-slate-400 leading-snug">Physiker & Mystiker der Raumzeit • Fische ☉ / Schütze ↑</p>
        <div class="text-[10px] font-bold text-amber-300/80 pt-1 group-hover:text-amber-300">Profil laden & Fragen stellen ➔</div>
      </button>

      <!-- 5. Vera F. Birkenbihl -->
      <button
        type="button"
        class="preset-btn p-4 rounded-2xl bg-slate-950/80 hover:bg-slate-900 border border-white/10 hover:border-amber-500/50 transition-all text-left space-y-1.5 group cursor-pointer shadow-md"
        data-date="1946-04-26"
        data-time="10:30"
        data-city="München"
        data-lat="48.1351"
        data-lng="11.5820"
        data-tz="Europe/Berlin"
        data-name="Vera F. Birkenbihl"
      >
        <div class="flex items-center justify-between">
          <span class="text-xl">💡</span>
          <span class="text-[10px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">1946</span>
        </div>
        <div class="font-bold text-white group-hover:text-amber-300 text-sm transition-colors">Vera F. Birkenbihl</div>
        <p class="text-[11px] text-slate-400 leading-snug">Pionierin der Neurodidaktik • Stier ☉ / Krebs ↑</p>
        <div class="text-[10px] font-bold text-amber-300/80 pt-1 group-hover:text-amber-300">Profil laden & Fragen stellen ➔</div>
      </button>

      <!-- 6. Steve Jobs -->
      <button
        type="button"
        class="preset-btn p-4 rounded-2xl bg-slate-950/80 hover:bg-slate-900 border border-white/10 hover:border-amber-500/50 transition-all text-left space-y-1.5 group cursor-pointer shadow-md"
        data-date="1955-02-24"
        data-time="19:15"
        data-city="San Francisco"
        data-lat="37.7749"
        data-lng="-122.4194"
        data-tz="America/Los_Angeles"
        data-name="Steve Jobs"
      >
        <div class="flex items-center justify-between">
          <span class="text-xl">🍎</span>
          <span class="text-[10px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">1955</span>
        </div>
        <div class="font-bold text-white group-hover:text-amber-300 text-sm transition-colors">Steve Jobs</div>
        <p class="text-[11px] text-slate-400 leading-snug">Visionär & Design-Philosoph • Fische ☉ / Jungfrau ↑</p>
        <div class="text-[10px] font-bold text-amber-300/80 pt-1 group-hover:text-amber-300">Profil laden & Fragen stellen ➔</div>
      </button>
    </div>
  </div>
</div>

<!-- Cosmic Calculation Loading Overlay -->
<div
  id="cosmicCalculationLoader"
  class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-xl flex flex-col items-center justify-center p-6 space-y-6 transition-all duration-300 opacity-0 pointer-events-none"
>
  <div class="relative flex items-center justify-center w-28 h-28">
    <div class="absolute inset-0 rounded-full border-2 border-amber-500/20 border-t-amber-400 animate-spin"></div>
    <div class="absolute inset-3 rounded-full border-2 border-purple-500/20 border-b-purple-400 animate-spin [animation-direction:reverse] [animation-duration:1.5s]"></div>
    <div class="absolute inset-6 rounded-full border-2 border-cyan-500/20 border-r-cyan-400 animate-spin [animation-duration:2s]"></div>
    <span class="text-3xl text-amber-300 animate-pulse">✦</span>
  </div>

  <div class="text-center space-y-2 max-w-sm">
    <h3 class="text-xl font-extrabold text-white tracking-wide">
      Himmelsmechanik & Seelenplan
    </h3>
    <p class="text-xs text-amber-300/90 font-medium" id="loaderStatusText">
      Berechne Ephemeriden, Häuser & Lebenswegzahl...
    </p>
    <div class="w-48 h-1.5 bg-slate-900 rounded-full overflow-hidden mx-auto border border-white/10">
      <div class="h-full bg-gradient-to-r from-amber-400 via-yellow-400 to-purple-500 animate-[pulse_1s_infinite] w-full"></div>
    </div>
  </div>
</div>
