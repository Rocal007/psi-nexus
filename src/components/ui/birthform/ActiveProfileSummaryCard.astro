---
interface Props {
  hasActiveProfile: boolean;
  defaultName: string;
  defaultDate: string;
  defaultTime: string;
  defaultCity: string;
  defaultSystem: string;
}

const {
  hasActiveProfile,
  defaultName,
  defaultDate,
  defaultTime,
  defaultCity,
  defaultSystem
} = Astro.props;
---

<!-- Active Profile Summary Card (Visible when form is collapsed & profile is active) -->
<div
  id="activeProfileSummaryCard"
  class={`cosmic-glass-gold rounded-3xl p-4 sm:p-5 border border-amber-500/40 shadow-xl flex flex-wrap items-center justify-between gap-4 relative overflow-visible transition-all duration-300 z-40 ${hasActiveProfile ? '' : 'hidden'}`}
>
  <div class="flex items-center gap-3.5 min-w-0">
    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-amber-400 to-purple-600 p-[1.5px] shadow-[0_0_15px_rgba(234,179,8,0.3)] shrink-0">
      <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center text-lg font-bold text-amber-300">
        <span id="summaryInitials">{defaultName ? defaultName.charAt(0).toUpperCase() : '✦'}</span>
      </div>
    </div>
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <span class="text-[10px] uppercase font-bold tracking-widest text-amber-400">Aktives Seelen-Profil (SQLite DB)</span>
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      </div>
      <h3 class="text-base sm:text-lg font-black text-white truncate" id="summaryPersonName">
        {defaultName || 'Edle Seele'}
      </h3>
      <div class="text-xs text-slate-300 flex flex-wrap items-center gap-1.5 mt-0.5" id="summaryDetails">
        <span>🗓️ {defaultDate || 'Datum'}, {defaultTime} Uhr</span>
        <span>•</span>
        <span>📍 {defaultCity || 'Ort'}</span>
        <span>•</span>
        <span class="text-amber-300 font-mono">({defaultSystem})</span>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
    <!-- Saved Profiles Quick Switcher Dropdown -->
    <div class="relative z-50" id="savedProfilesContainer">
      <button
        type="button"
        id="savedProfilesBtn"
        class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 text-xs font-semibold text-slate-200 hover:text-white transition-all cursor-pointer flex items-center gap-1.5 shadow-md hover:border-amber-500/40"
      >
        <span>👥</span>
        <span>Profile (<span id="profileCountBadge">0</span>)</span>
        <span class="text-[10px] text-slate-400">▼</span>
      </button>

      <div
        id="savedProfilesMenu"
        class="absolute right-0 top-full mt-2.5 w-72 sm:w-80 bg-slate-950/98 backdrop-blur-2xl border border-amber-500/50 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.95)] z-[9999] p-2.5 space-y-1.5 hidden"
      >
        <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-white/10 flex items-center justify-between">
          <span>Gespeicherte Personen (DB)</span>
          <span class="text-amber-400 font-mono text-[9px]">Klick zum Wechseln</span>
        </div>
        <div id="savedProfilesList" class="max-h-60 overflow-y-auto space-y-1.5 p-0.5">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>

    <!-- Toggle Form Edit Button -->
    <button
      type="button"
      id="toggleFormBtn"
      class="px-4 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer shadow-[0_0_15px_rgba(234,179,8,0.2)] hover:scale-105"
    >
      <span>✏️</span>
      <span>Daten anpassen</span>
    </button>

    <!-- New Profile Button -->
    <button
      type="button"
      id="newProfileBtn"
      class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/15 text-slate-200 hover:text-white text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer hover:border-amber-500/40 shadow-md"
      title="Neues Seelen-Profil anlegen"
    >
      <span>✧</span>
      <span>Neu</span>
    </button>

    <!-- Delete Current Profile Button -->
    <button
      type="button"
      id="deleteCurrentProfileBtn"
      class="px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-300 hover:text-rose-200 text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer hover:border-rose-500/60 shadow-md"
      title="Aktuelles Profil aus der Datenbank löschen"
    >
      <span>🗑️</span>
      <span class="hidden sm:inline">Löschen</span>
    </button>
  </div>
</div>
