---
// Multi-Theme Space Backdrop: Cosmic Hubble, NASA Flight Telemetry HUD & Medieval German Astrolabe
import { CONSTELLATIONS, type ConstellationData } from '../../lib/astrology/constellations';

// Default initial constellations (Taurus Sun, Cancer Moon, Leo Ascendant)
const sunConstellation = CONSTELLATIONS.find(c => c.id === 'taurus') || CONSTELLATIONS[1];
const moonConstellation = CONSTELLATIONS.find(c => c.id === 'cancer') || CONSTELLATIONS[3];
const ascConstellation = CONSTELLATIONS.find(c => c.id === 'leo') || CONSTELLATIONS[4];

function generateConstellationSvg(c: ConstellationData, colorHex: string, glowFilter: string, tagLabel: string) {
  const starsHtml = c.stars.map((s, idx) => {
    const isAlpha = idx === 0;
    return `
      <g>
        <circle cx="${s.x}" cy="${s.y}" r="${isAlpha ? s.size + 1.5 : s.size + 0.5}" fill="${isAlpha ? '#ffffff' : colorHex}" filter="url(#${glowFilter})" class="${isAlpha ? 'animate-celestial-pulse' : 'animate-star-twinkle'}" />
        ${s.name ? `<text x="${s.x + 5}" y="${s.y - 4}" fill="${colorHex}" font-size="8" font-family="var(--theme-font-head)" font-weight="700" opacity="0.85">${s.name}</text>` : ''}
      </g>
    `;
  }).join('');

  const linesHtml = c.lines.map(l => {
    const s1 = c.stars[l.from];
    const s2 = c.stars[l.to];
    if (!s1 || !s2) return '';
    return `<line x1="${s1.x}" y1="${s1.y}" x2="${s2.x}" y2="${s2.y}" stroke="${colorHex}" stroke-width="1.3" stroke-dasharray="4 2" stroke-opacity="0.5" />`;
  }).join('');

  return `
    ${linesHtml}
    ${starsHtml}
    <text x="50" y="112" fill="${colorHex}" font-size="10" font-family="var(--theme-font-head)" font-weight="800" text-anchor="middle" letter-spacing="2">
      ${tagLabel}: ${c.latinName.toUpperCase()} (${c.symbol})
    </text>
  `;
}
---

<!-- Fixed Multi-Theme Backdrop Layer -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
  
  <!-- 1. Cosmic NASA Hubble Background Image (Adaptive Opacity) -->
  <div
    class="cosmic-hubble-bg absolute inset-0 bg-cover bg-center bg-no-repeat opacity-45 mix-blend-screen transform scale-105 transition-all duration-700"
    style="background-image: url('/images/hubble_nebula.jpg'); filter: contrast(1.2) brightness(0.9) saturate(1.25);"
  ></div>

  <!-- 2. Medieval Parchment & Woodcut Texture Overlay -->
  <div class="medieval-texture-overlay absolute inset-0 opacity-0 pointer-events-none transition-opacity duration-700"></div>

  <!-- 3. Deep Obsidian / Space Vignette & Depth Layers -->
  <div class="theme-vignette absolute inset-0 bg-gradient-to-b from-slate-950/85 via-slate-950/40 to-slate-950/95 transition-colors duration-700"></div>
